rules_version = '2';

// Alineado con StoragePathBuilder.swift + rutas legado + salidas de Cloud Functions (processed_videos).
service firebase.storage {
  match /b/{bucket}/o {

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isActive', true);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Escritura en rutas users/{uid}/…: el dueño autenticado (sin get Firestore en write — evita 403 en thumbnails, etc.).
    function canWriteAsOwner(userId) {
      return isOwner(userId);
    }

    function hasImageContentType() {
      return !('contentType' in request.resource) || request.resource.contentType.matches('image/.*');
    }

    function hasMomentMediaContentType() {
      return !('contentType' in request.resource) ||
             request.resource.contentType.matches('image/.*|video/.*');
    }

    function hasStoryMediaContentType() {
      return !('contentType' in request.resource) ||
             request.resource.contentType.matches('image/.*|video/.*|audio/.*');
    }

    function hasHiddenLayerContentType() {
      return !('contentType' in request.resource) ||
             request.resource.contentType.matches('image/.*|audio/.*');
    }

    function hasChatMediaContentType() {
      return !('contentType' in request.resource) ||
             request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf|application/octet-stream');
    }

    // Lectura de media de perfil no enlazada a un documento de contenido.
    function canReadOwnerProfileMedia(ownerId) {
      return isAuthenticated() && (
        request.auth.uid == ownerId ||
        (firestore.exists(/databases/(default)/documents/users/$(ownerId)) &&
         firestore.get(/databases/(default)/documents/users/$(ownerId)).data.get('isActive', true))
      );
    }

    function canViewOwnerProfile(viewerId, ownerId) {
      let ownerDoc = firestore.get(/databases/(default)/documents/users/$(ownerId));
      return viewerId == ownerId ||
             (ownerDoc.data.get('isActive', true) &&
              (!ownerDoc.data.get('isPrivate', false) ||
               firestore.exists(/databases/(default)/documents/users/$(viewerId)/following/$(ownerId))));
    }

    function canViewCustomContent(viewerId, ownerId, contentType, contentId) {
      let audienceDocId = contentType + '_' + contentId;
      return firestore.exists(/databases/(default)/documents/users/$(ownerId)/customAudiences/$(audienceDocId)) &&
             viewerId in firestore.get(/databases/(default)/documents/users/$(ownerId)/customAudiences/$(audienceDocId)).data.get('allowedUsers', []);
    }

    function isUserInCustomList(viewerId, ownerId, customListId) {
      return customListId != '' &&
             firestore.exists(/databases/(default)/documents/users/$(ownerId)/customAudienceLists/$(customListId)) &&
             viewerId in firestore.get(/databases/(default)/documents/users/$(ownerId)/customAudienceLists/$(customListId)).data.get('members', []);
    }

    // Mantener Storage alineado con firestore.rules canViewContentWithAudience().
    function canViewContentWithAudience(viewerId, ownerId, audience, contentType, contentId, customListId) {
      return viewerId == ownerId ||
             (firestore.exists(/databases/(default)/documents/users/$(ownerId)) &&
              firestore.get(/databases/(default)/documents/users/$(ownerId)).data.get('isActive', true) &&
              canViewOwnerProfile(viewerId, ownerId) &&
              (audience == 'everyone' ||
               (audience == 'mutuals' &&
                firestore.exists(/databases/(default)/documents/users/$(viewerId)/mutuals/$(ownerId))) ||
               (audience == 'bestFriends' &&
                viewerId in firestore.get(/databases/(default)/documents/users/$(ownerId)).data.get('bestFriends', [])) ||
               (audience == 'custom' &&
                canViewCustomContent(viewerId, ownerId, contentType, contentId)) ||
               (audience == 'customList' &&
                isUserInCustomList(viewerId, ownerId, customListId)) ||
               (audience == 'onlyMe' && false)
              )
             );
    }

    function canReadMomentMedia(ownerId, momentId) {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/users/$(ownerId)/moments/$(momentId)) &&
             canViewContentWithAudience(
               request.auth.uid,
               ownerId,
               firestore.get(/databases/(default)/documents/users/$(ownerId)/moments/$(momentId)).data.get('audience', 'everyone'),
               'moment',
               momentId,
               firestore.get(/databases/(default)/documents/users/$(ownerId)/moments/$(momentId)).data.get('customListId', '')
             );
    }

    function canReadStoryMedia(ownerId, storyId) {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/users/$(ownerId)/stories/$(storyId)) &&
             canViewContentWithAudience(
               request.auth.uid,
               ownerId,
               firestore.get(/databases/(default)/documents/users/$(ownerId)/stories/$(storyId)).data.get('audience', 'everyone'),
               'story',
               storyId,
               firestore.get(/databases/(default)/documents/users/$(ownerId)/stories/$(storyId)).data.get('customListId', '')
             );
    }

    function legacyObjectBelongsToRequester(objectId) {
      return isAuthenticated() &&
             request.auth.uid.matches('[A-Za-z0-9_-]+') &&
             objectId.matches('.*_' + request.auth.uid + '\\.[^/]+');
    }

    function conversationPath(conversationId) {
      return /databases/(default)/documents/conversations/$(conversationId);
    }

    function conversationDoc(conversationId) {
      return firestore.get(conversationPath(conversationId));
    }

    function messageRequestPath(threadId) {
      return /databases/(default)/documents/messageRequests/$(threadId);
    }

    function isPendingRequestParticipant(threadId) {
      return isAuthenticated()
        && firestore.exists(messageRequestPath(threadId))
        && request.auth.uid in firestore.get(messageRequestPath(threadId)).data.participants;
    }

    function canWritePendingRequestMedia(threadId) {
      return isAuthenticated()
        && firestore.exists(messageRequestPath(threadId))
        && firestore.get(messageRequestPath(threadId)).data.schemaVersion == 2
        && firestore.get(messageRequestPath(threadId)).data.state == 'pending'
        && firestore.get(messageRequestPath(threadId)).data.initiatorId == request.auth.uid;
    }

    // participants[] o claves de participantData (conversaciones antiguas / migraciones).
    function isConversationParticipant(conversationId) {
      return isAuthenticated() &&
             firestore.exists(conversationPath(conversationId)) &&
             (
               request.auth.uid in conversationDoc(conversationId).data.participants
               || (
                 'participantData' in conversationDoc(conversationId).data
                 && request.auth.uid in conversationDoc(conversationId).data.participantData
               )
             );
    }

    function canReadChatMedia(userId, conversationId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        isConversationParticipant(conversationId)
      );
    }

    function validImageUpload() {
      return hasImageContentType() && request.resource.size < 10 * 1024 * 1024;
    }

    function validNovaMediaUpload() {
      return request.resource.contentType.matches('application/octet-stream') &&
             request.resource.size < 15 * 1024 * 1024;
    }

    // CreatorMedia.maxMomentVideoUploadSizeBytes = 300 MB
    function validMomentMediaUpload() {
      return hasMomentMediaContentType() && request.resource.size < 300 * 1024 * 1024;
    }

    function validStoryMediaUpload() {
      return hasStoryMediaContentType() && request.resource.size < 300 * 1024 * 1024;
    }

    function validHiddenLayerUpload() {
      return hasHiddenLayerContentType() && request.resource.size < 25 * 1024 * 1024;
    }

    // VideoCompressionPreset.chat → máx. ~80 MB de salida
    function validChatMediaUpload() {
      return hasChatMediaContentType() && request.resource.size < 85 * 1024 * 1024;
    }

    function validExportUpload() {
      return request.resource.contentType.matches('application/zip|application/octet-stream') &&
             request.resource.size < 500 * 1024 * 1024;
    }

    // -------------------------------------------------------------------------
    // Nuevo layout: users/{uid}/…
    // -------------------------------------------------------------------------

    match /users/{userId}/profile/avatar/{fileName} {
      allow read: if canReadOwnerProfileMedia(userId);
      allow write: if canWriteAsOwner(userId) && validImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/nova/{conversationId}/{messageId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if canWriteAsOwner(userId) && validNovaMediaUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/moments/{momentId}/media/{fileName} {
      allow read: if isOwner(userId) || canReadMomentMedia(userId, momentId);
      allow write: if canWriteAsOwner(userId) && validMomentMediaUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/moments/{momentId}/thumbnails/{fileName} {
      allow read: if isOwner(userId) || canReadMomentMedia(userId, momentId);
      allow write: if canWriteAsOwner(userId) && validImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/moments/{momentId}/hidden_layers/{layerId}/{fileName} {
      allow read: if isOwner(userId) || canReadMomentMedia(userId, momentId);
      allow write: if canWriteAsOwner(userId) && validHiddenLayerUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/stories/{storyId}/media/{fileName} {
      allow read: if isOwner(userId) || canReadStoryMedia(userId, storyId);
      allow write: if canWriteAsOwner(userId) && validStoryMediaUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/stories/{storyId}/thumbnails/{fileName} {
      allow read: if isOwner(userId) || canReadStoryMedia(userId, storyId);
      allow write: if canWriteAsOwner(userId) && validImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/stories/{storyId}/frames/{fileName} {
      allow read: if isOwner(userId) || canReadStoryMedia(userId, storyId);
      allow write: if canWriteAsOwner(userId) && validImageUpload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/stories/{storyId}/audio/{fileName} {
      allow read: if isOwner(userId) || canReadStoryMedia(userId, storyId);
      allow write: if canWriteAsOwner(userId) &&
                        hasHiddenLayerContentType() &&
                        request.resource.size < 25 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // Chat: media principal (media.enc, etc.)
    // Write: solo el dueño del path (request.auth.uid == userId). No hace falta get() a Firestore en write.
    // Read: participantes de la conversación (pueden leer media del otro en users/{otroUid}/chat/...).
    match /users/{userId}/chat/{conversationId}/{messageId}/{fileName} {
      allow read: if canReadChatMedia(userId, conversationId);
      allow write: if canWriteAsOwner(userId) && validChatMediaUpload();
      allow delete: if isOwner(userId);
    }

    // Chat: miniaturas de vídeo (cifrado → octet-stream)
    match /users/{userId}/chat/{conversationId}/{messageId}/thumbnails/{fileName} {
      allow read: if canReadChatMedia(userId, conversationId);
      allow write: if canWriteAsOwner(userId) && validChatThumbnailUpload();
      allow delete: if isOwner(userId);
    }

    function validChatThumbnailUpload() {
      return (!('contentType' in request.resource) ||
              request.resource.contentType.matches('image/.*|application/octet-stream')) &&
             request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{userId}/exports/{fileName} {
      allow read: if isOwner(userId);
      allow write: if canWriteAsOwner(userId) && validExportUpload();
      allow delete: if isOwner(userId);
    }

    // No abrir rutas nuevas por defecto bajo users/{uid}/...
    // Cualquier carpeta nueva debe declararse arriba con reglas explícitas.
    match /users/{userId}/{allPaths=**} {
      allow read, write, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Salidas de transcodificación (solo Functions escriben vía Admin SDK)
    // -------------------------------------------------------------------------

    match /processed_videos/moments/{userId}/{momentId}/{fileName} {
      allow read: if canReadMomentMedia(userId, momentId);
      allow write: if false;
      allow delete: if false;
    }

    match /processed_videos/stories/{userId}/{storyId}/{fileName} {
      allow read: if canReadStoryMedia(userId, storyId);
      allow write: if false;
      allow delete: if false;
    }

    match /processed_videos/{allPaths=**} {
      allow read, write, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Legado (contenido ya subido)
    // -------------------------------------------------------------------------

    match /conversations/{conversationId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      allow write: if isConversationParticipant(conversationId) && validChatMediaUpload();
      allow delete: if isConversationParticipant(conversationId);
    }

    match /hidden_layers/{userId}/{momentId}/{fileName} {
      allow read: if canReadMomentMedia(userId, momentId);
      allow write: if canWriteAsOwner(userId) && validHiddenLayerUpload();
      allow delete: if isOwner(userId);
    }

    match /background_frames/{userId}/{storyId}/{fileName} {
      allow read: if canReadStoryMedia(userId, storyId);
      allow write: if canWriteAsOwner(userId) && validImageUpload();
      allow delete: if isOwner(userId);
    }

    match /background_frames/{userId}/{fileName} {
      allow read: if canReadOwnerProfileMedia(userId);
      allow write: if canWriteAsOwner(userId) && validImageUpload();
      allow delete: if isOwner(userId);
    }

    match /background_frames/{userId}/{allPaths=**} {
      allow read, write, delete: if false;
    }

    match /images/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() &&
                        legacyObjectBelongsToRequester(imageId) &&
                        request.resource.contentType.matches('image/.*') &&
                        request.resource.size < 10 * 1024 * 1024;
      allow delete: if isActiveUser() && legacyObjectBelongsToRequester(imageId);
    }

    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() &&
                        legacyObjectBelongsToRequester(videoId) &&
                        request.resource.contentType.matches('video/.*') &&
                        request.resource.size < 300 * 1024 * 1024;
      allow delete: if isActiveUser() && legacyObjectBelongsToRequester(videoId);
    }

    match /exports/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if canWriteAsOwner(userId) && validExportUpload();
      allow delete: if isOwner(userId);
    }

    // Ruta estable antes y después de aceptar. El contenido siempre es un
    // blob cifrado; el backend valida y enlaza su storagePath al mensaje V2.
    match /directThreads/{threadId}/{messageId}/{fileName} {
      allow read: if isActiveUser()
                    && (isPendingRequestParticipant(threadId) || isConversationParticipant(threadId));

      allow write: if isActiveUser()
                     && (canWritePendingRequestMedia(threadId) || isConversationParticipant(threadId))
                     && request.resource.contentType.matches('application/octet-stream')
                     && request.resource.metadata.ownerId == request.auth.uid
                     && request.resource.metadata.threadId == threadId
                     && request.resource.metadata.messageId == messageId
                     && request.resource.size < 85 * 1024 * 1024;

      allow delete: if isActiveUser()
                      && resource.metadata.ownerId == request.auth.uid
                      && (canWritePendingRequestMedia(threadId) || isConversationParticipant(threadId));
    }

    match /messageRequests/{requestId}/{fileName} {
      allow read, write, delete: if false;
    }
  }
}
