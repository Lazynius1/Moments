rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =====================================================================
    // HELPER FUNCTIONS
    // =====================================================================

    // ✅ ACTUALIZADA: Función helper para verificar si un usuario puede ver contenido
    function canViewContent(viewerId, ownerId) {
      let ownerDoc = get(/databases/$(database)/documents/users/$(ownerId));
      return viewerId == ownerId ||
             (ownerDoc.data.get('isActive', true) && // ✅ NUEVO: Verificar que la cuenta esté activa
              (!ownerDoc.data.isPrivate ||
               exists(/databases/$(database)/documents/users/$(viewerId)/following/$(ownerId))));
    }

    // ✅ NUEVA: Función helper más permisiva para operaciones de feed
    function canReadForFeed(viewerId, ownerId) {
      return viewerId == ownerId ||
             exists(/databases/$(database)/documents/users/$(ownerId)) &&
             get(/databases/$(database)/documents/users/$(ownerId)).data.get('isActive', true);
    }

    // ✅ CORREGIDA: Función helper para verificar audiencia personalizada
    function canViewCustomContent(viewerId, ownerId, contentType, contentId) {
      let audienceDocId = contentType + '_' + contentId;
      return exists(/databases/$(database)/documents/users/$(ownerId)/customAudiences/$(audienceDocId)) &&
             viewerId in get(/databases/$(database)/documents/users/$(ownerId)/customAudiences/$(audienceDocId)).data.allowedUsers;
    }

    // ✅ FUNCIÓN HELPER NUEVA: Verificar si un usuario está en una lista personalizada
    function isUserInCustomList(viewerId, ownerId, customListId) {
      return customListId != '' &&
             exists(/databases/$(database)/documents/users/$(ownerId)/customAudienceLists/$(customListId)) &&
             viewerId in get(/databases/$(database)/documents/users/$(ownerId)/customAudienceLists/$(customListId)).data.members;
    }

            // ✅ SIMPLIFICADA: Función helper para verificar audiencia más robusta
        function canViewContentWithAudience(viewerId, ownerId, audience, contentType, contentId, customListId) {
          // ✅ Verificación básica primero
          return viewerId == ownerId ||
                 (get(/databases/$(database)/documents/users/$(ownerId)).data.get('isActive', true) &&
                  canViewContent(viewerId, ownerId) &&
                  (audience == 'everyone' ||
                   (audience == 'mutuals' &&
                    exists(/databases/$(database)/documents/users/$(viewerId)/mutuals/$(ownerId))) ||
                   (audience == 'bestFriends' &&
                    viewerId in get(/databases/$(database)/documents/users/$(ownerId)).data.bestFriends) ||
                   (audience == 'custom' &&
                    canViewCustomContent(viewerId, ownerId, contentType, contentId)) ||
                   (audience == 'customList' &&
                    isUserInCustomList(viewerId, ownerId, customListId)) ||
                   (audience == 'onlyMe' && false)
                  )
                 );
        }

    // ✅ NUEVA: Función helper para verificar si una cuenta puede ser seguida
    function canFollowUser(followerId, targetUserId) {
      let followerUserDoc = get(/databases/$(database)/documents/users/$(followerId));
      let targetUserDoc = get(/databases/$(database)/documents/users/$(targetUserId));
      return followerUserDoc.data.get('isActive', true) && targetUserDoc.data.get('isActive', true); // Ambos usuarios deben estar activos
    }

    // 🔐 Verifica que una relación privada fue aprobada por el dueño de la cuenta privada.
    function hasAcceptedFollowRequest(followerId, targetUserId, requestId) {
      return requestId is string &&
             requestId != '' &&
             exists(/databases/$(database)/documents/users/$(targetUserId)/receivedFollowRequests/$(requestId)) &&
             get(/databases/$(database)/documents/users/$(targetUserId)/receivedFollowRequests/$(requestId)).data.senderId == followerId &&
             get(/databases/$(database)/documents/users/$(targetUserId)/receivedFollowRequests/$(requestId)).data.recipientId == targetUserId &&
             get(/databases/$(database)/documents/users/$(targetUserId)/receivedFollowRequests/$(requestId)).data.status == 'pending';
    }

    // 🔐 Solo el seguidor puede crear follows públicos; las cuentas privadas requieren aprobación del destinatario.
    function canCreateFollowingDocument(followerId, targetUserId) {
      let targetUserDoc = get(/databases/$(database)/documents/users/$(targetUserId));
      return request.resource.data.userId == targetUserId &&
             request.resource.data.timestamp is timestamp &&
             canFollowUser(followerId, targetUserId) &&
             ((request.auth.uid == followerId && !targetUserDoc.data.get('isPrivate', false)) ||
              (request.auth.uid == targetUserId &&
               hasAcceptedFollowRequest(followerId, targetUserId, request.resource.data.get('acceptedFollowRequestId', ''))));
    }

    // 🔐 Mantiene followers sincronizado sin permitir que terceros falsifiquen el grafo social.
    function canCreateFollowerDocument(targetUserId, followerId) {
      let targetUserDoc = get(/databases/$(database)/documents/users/$(targetUserId));
      return request.resource.data.userId == followerId &&
             request.resource.data.timestamp is timestamp &&
             canFollowUser(followerId, targetUserId) &&
             ((request.auth.uid == followerId && !targetUserDoc.data.get('isPrivate', false)) ||
              (request.auth.uid == targetUserId &&
               hasAcceptedFollowRequest(followerId, targetUserId, request.resource.data.get('acceptedFollowRequestId', ''))));
    }

    // 🔐 Reutiliza las comprobaciones de audiencia para consultas collectionGroup de contenido.
    function canViewCollectionGroupContent(viewerId, contentType, contentId) {
      let ownerId = resource.data.get('authorId', '');
      return ownerId is string &&
             ownerId != '' &&
             canViewContentWithAudience(
               viewerId,
               ownerId,
               resource.data.get('audience', 'everyone'),
               contentType,
               contentId,
               resource.data.get('customListId', '')
             );
    }

    function isValidChatRecoveryBundle(data) {
      return data.keys().hasOnly([
               'keyId',
               'encryptedPrivateKey',
               'nonce',
               'salt',
               'kdf',
               'kdfParams',
               'keyVersion',
               'encryptedUserKey',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasAll(['encryptedPrivateKey', 'nonce', 'salt', 'kdf', 'kdfParams', 'keyVersion']) &&
             (!('keyId' in data) || data.keyId is string) &&
             data.encryptedPrivateKey is string &&
             data.encryptedPrivateKey.size() >= 40 &&
             data.encryptedPrivateKey.size() <= 5468 &&
             data.nonce is string &&
             data.nonce.size() > 0 &&
             data.nonce.size() <= 128 &&
             data.salt is string &&
             data.salt.size() == 44 &&
             data.kdf == 'PBKDF2' &&
             data.kdfParams is map &&
             data.kdfParams.keys().hasOnly(['iterations', 'keyLength', 'hash']) &&
             data.kdfParams.iterations == 200000 &&
             data.kdfParams.keyLength == 32 &&
             data.kdfParams.hash == 'SHA256' &&
             data.keyVersion is int &&
             data.keyVersion >= 1 &&
             data.keyVersion <= 10 &&
             (!('encryptedUserKey' in data) ||
               (data.encryptedUserKey is string &&
                data.encryptedUserKey.size() >= 40 &&
                data.encryptedUserKey.size() <= 5468)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidChatRecoveryMigration(data, migrationId) {
      return data.keys().hasOnly([
               'migrationId',
               'keyId',
               'scheme',
               'wrappedPayload',
               'createdAt',
               'expiresAt',
               'consumedAt'
             ]) &&
             data.keys().hasAll(['migrationId', 'keyId', 'scheme', 'wrappedPayload', 'expiresAt']) &&
             data.migrationId == migrationId &&
             data.migrationId is string &&
             data.migrationId.size() >= 8 &&
             data.migrationId.size() <= 64 &&
             data.keyId is string &&
             data.keyId.size() > 0 &&
             data.keyId.size() <= 64 &&
             data.scheme == 'aes-gcm-v1' &&
             data.wrappedPayload is string &&
             data.wrappedPayload.size() >= 40 &&
             data.wrappedPayload.size() <= 8192 &&
             data.expiresAt is timestamp &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('consumedAt' in data) || data.consumedAt == null);
    }

    // ✅ NUEVA: Función para verificar si un usuario puede participar en conversaciones
    function canParticipateInConversations(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
    }
    
        // ✅ NUEVA: Función para validar memoria categorizada de Nova
        function isValidNovaMemory(memoryData) {
          return memoryData.keys().hasAll(['id', 'userId', 'facts', 'lastUpdated', 'createdAt']) &&
                 memoryData.id is string &&
                 memoryData.userId is string &&
                 memoryData.facts is list &&
                 memoryData.facts.size() <= 20 && // Máximo 20 hechos categorizados
                 memoryData.lastUpdated is timestamp &&
                 memoryData.createdAt is timestamp &&
                 // Validar que cada hecho sea un objeto válido
                 isValidCategorizedFactsList(memoryData.facts);
        }

        // ✅ NUEVA: Función para validar lista de hechos categorizados
        function isValidCategorizedFactsList(factsList) {
          return factsList.size() == 0 || // Lista vacía es válida
                 (factsList.size() > 0 && isValidNovaFact(factsList[0])); // Solo validar el primer elemento para simplificar
        }

        // ✅ NUEVA: Función para validar un hecho categorizado individual
        function isValidNovaFact(fact) {
          return fact.keys().hasAll(['id', 'content', 'type', 'timestamp', 'importance']) &&
                 fact.id is string &&
                 fact.content is string &&
                 fact.content.size() > 0 &&
                 fact.content.size() <= 4096 &&
                 fact.type is string &&
                 fact.type in ['preference', 'personal', 'professional', 'interest', 'general'] &&
                 fact.timestamp is timestamp &&
                 fact.importance is int &&
                 fact.importance >= 1 &&
                 fact.importance <= 5;
        }

        // ✅ Validar tamaño total de datos de memoria (ciphertext puede ser más grande que plaintext)
        function isMemorySizeValid(memoryData) {
          return memoryData.facts.size() <= 20;
        }

        // ✅ Nova context doc (conversation summaries) — separate schema from facts memory
        function isValidNovaConversationSummary(summary) {
          return summary.keys().hasAll(['id', 'summary', 'createdAt']) &&
                 summary.id is string &&
                 summary.summary is string &&
                 summary.summary.size() >= 1 &&
                 summary.summary.size() <= 8192 &&
                 summary.createdAt is timestamp &&
                 (!('conversationId' in summary) || summary.conversationId is string);
        }

        function isValidNovaConversationSummariesList(summariesList) {
          return summariesList.size() == 0 ||
                 (summariesList.size() > 0 && isValidNovaConversationSummary(summariesList[0]));
        }

        function isValidNovaContext(contextData) {
          return contextData.keys().hasAll(['userId', 'conversationSummaries']) &&
                 contextData.userId is string &&
                 contextData.conversationSummaries is list &&
                 contextData.conversationSummaries.size() <= 5 &&
                 isValidNovaConversationSummariesList(contextData.conversationSummaries);
        }

        // ✅ Nova conversations — user-scoped chat history
        function isValidNovaSavedConversation(conversationData, userId) {
          return conversationData.keys().hasAll(['id', 'title', 'messages', 'createdAt', 'lastUpdated', 'userId']) &&
                 conversationData.id is string &&
                 conversationData.id.size() > 0 &&
                 conversationData.title is string &&
                 conversationData.title.size() > 0 &&
                 conversationData.title.size() <= 512 &&
                 conversationData.messages is list &&
                 conversationData.messages.size() <= 300 &&
                 conversationData.createdAt is timestamp &&
                 conversationData.lastUpdated is timestamp &&
                 conversationData.userId is string &&
                 conversationData.userId == userId;
        }
        
        // ✅ Prevenir spam de actualizaciones de memoria - SIN TIMEOUT
        function canUpdateNovaMemory(userId) {
          // Siempre permitir actualizar (sin timeout, las otras validaciones previenen spam)
          return true;
        }
        
    
    // =====================================================================
    // USER COLLECTIONS
    // =====================================================================
        match /users/{userId} {
        // Regla de lectura sin cambios
        allow read: if request.auth != null && (
            request.auth.uid == userId ||
            resource.data.get('isActive', true) ||
            (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
            );
    
            // ✅ REGLA DE CREACIÓN CORREGIDA
            allow create: if request.auth != null
                && request.auth.uid == userId
                && request.resource.data.id == userId
                // ✅ CAMBIO CRÍTICO: Eliminar la validación estricta del email
                && request.resource.data.email is string
                && request.resource.data.email.size() > 0
                // Validaciones básicas del modelo
                && request.resource.data.username is string
                && request.resource.data.username.size() > 0
                && request.resource.data.interests is list
                && request.resource.data.isPlusSubscriber is bool
                && request.resource.data.blockedUsers is list
                && request.resource.data.isPrivate is bool
                && request.resource.data.showMutuals is bool
                && request.resource.data.showFollowing is bool
                && request.resource.data.showFollowers is bool
                && request.resource.data.bestFriends is list
                && request.resource.data.get('isActive', true) == true  // ✅ Asegurar que sea true
                && request.resource.data.get('showBadge', true) is bool
                && request.resource.data.get('showPlusBadge', true) is bool
                && request.resource.data.get('isVerified', false) is bool
                && request.resource.data.get('onlineStatus', 'offline') is string
                && request.resource.data.get('isOnline', false) is bool
                // Campos opcionales
                && (!("ownedBadges" in request.resource.data) || request.resource.data.ownedBadges is list)
                && (!("plusSubscription" in request.resource.data) || request.resource.data.plusSubscription is map)
                && (!("profileImagePath" in request.resource.data) || request.resource.data.profileImagePath is string)
                && (!("bio" in request.resource.data) || request.resource.data.bio is string)
                && (!("profileNote" in request.resource.data) || (
                    request.resource.data.profileNote is string
                    && request.resource.data.profileNote.size() <= 28
                ))
                && (!("activeHoursStart" in request.resource.data) || request.resource.data.activeHoursStart is string)
                && (!("activeHoursEnd" in request.resource.data) || request.resource.data.activeHoursEnd is string)
                && (!("notificationPreferences" in request.resource.data) || request.resource.data.notificationPreferences is map)
                && (!("primaryBadgeId" in request.resource.data) || request.resource.data.primaryBadgeId is string)
                && (!("selectedProfileTheme" in request.resource.data) || request.resource.data.selectedProfileTheme is string)
                && (!("lastSeen" in request.resource.data) || request.resource.data.lastSeen is timestamp)
                    && (!("encryptionPublicKeyBase64" in request.resource.data) || request.resource.data.encryptionPublicKeyBase64 is string)
                && (!("chatKey" in request.resource.data) || request.resource.data.chatKey is map)
                // No permitir campos de desactivación en creación
                && !("deactivatedAt" in request.resource.data)
                && !("deactivatedBy" in request.resource.data)
                && !("reactivatedAt" in request.resource.data);

          // Permitir actualización de campos de desactivación/reactivación y estado en línea
          allow update: if request.auth != null
            && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['incognito'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileNote'])
              || (
                request.resource.data.profileNote is string
                && request.resource.data.profileNote.size() <= 28
              )
            )
            && (
            // Actualizaciones normales (cualquier campo excepto los de gestión de cuenta)
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive', 'deactivatedAt', 'deactivatedBy', 'reactivatedAt']) ||
            // O actualizaciones específicas de gestión de cuenta
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'deactivatedAt', 'deactivatedBy']) &&
             request.resource.data.isActive == false &&
             request.resource.data.deactivatedAt is timestamp &&
             request.resource.data.deactivatedBy is string) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'reactivatedAt']) &&
             request.resource.data.isActive == true &&
             request.resource.data.reactivatedAt is timestamp) ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'reactivatedAt', 'deactivatedAt', 'deactivatedBy']) &&
             request.resource.data.isActive == true &&
             request.resource.data.reactivatedAt is timestamp) ||
            // ✅ NUEVO: Regla para actualización de estado en línea
            (request.resource.data.diff(resource.data).affectedKeys().hasAny(['onlineStatus', 'lastSeen', 'isOnline']) &&
             (!("onlineStatus" in request.resource.data) || request.resource.data.onlineStatus is string) &&
             (!("lastSeen" in request.resource.data) || request.resource.data.lastSeen is timestamp) &&
             (!("isOnline" in request.resource.data) || request.resource.data.isOnline is bool)) ||
            // ✅ NUEVO: Regla para cambio de username (solo el propio campo + cooldown)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'lastUsernameChange']) &&
             request.resource.data.username is string &&
             request.resource.data.username.size() >= 3 &&
             request.resource.data.username.size() <= 30 &&
             request.resource.data.lastUsernameChange is timestamp)
          );

          allow delete: if request.auth != null && request.auth.uid == userId;

            
            // ✅ NUEVA: Regla para dispositivos del usuario
            match /devices/{deviceId} {
              allow read, write: if request.auth != null &&
                request.auth.uid == userId &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
            }

            // ✅ NUEVA: Regla para passkeys del usuario
            match /passkeys/{passkeyId} {
              allow read: if request.auth != null && request.auth.uid == userId;
              allow write: if false; // Solo escritura desde Cloud Functions
            }

            match /chatRecovery/{bundleId} {
              allow read: if request.auth != null &&
                request.auth.uid == userId &&
                bundleId == "default" &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
              allow create, update: if request.auth != null &&
                request.auth.uid == userId &&
                bundleId == "default" &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true) &&
                isValidChatRecoveryBundle(request.resource.data);
              allow delete: if request.auth != null &&
                request.auth.uid == userId &&
                bundleId == "default" &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
            }

            match /chatRecoveryMigrations/{migrationId} {
              allow read: if request.auth != null &&
                request.auth.uid == userId &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
              allow create: if request.auth != null &&
                request.auth.uid == userId &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true) &&
                isValidChatRecoveryMigration(request.resource.data, migrationId);
              allow update: if request.auth != null &&
                request.auth.uid == userId &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true) &&
                resource.data.consumedAt == null &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumedAt']) &&
                request.resource.data.consumedAt is timestamp;
              allow delete: if request.auth != null &&
                request.auth.uid == userId &&
                get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
            }

            // ✅ NUEVA: Historial de conversaciones de Nova por usuario
            match /novaConversations/{conversationId} {
              allow read: if request.auth != null && request.auth.uid == userId;

              allow create: if request.auth != null
                && request.auth.uid == userId
                && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                && isValidNovaSavedConversation(request.resource.data, userId);

              allow update: if request.auth != null
                && request.auth.uid == userId
                && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                && isValidNovaSavedConversation(request.resource.data, userId);

              allow delete: if request.auth != null && request.auth.uid == userId;
            }

      // ✅ REGLA UNIFICADA: Momentos del usuario con comentarios y reacciones
      // (La regla completa está en la línea 443 con validaciones avanzadas)

      // SISTEMA DE SEGUIMIENTO
      match /following/{followedUserId} {
        // ✅ CORREGIDA: Regla más permisiva para lectura de following
        allow read: if request.auth != null && (
          request.auth.uid == userId || // El propietario ve todos sus seguimientos
          (canViewContent(request.auth.uid, userId) && // ✅ Puedes ver el perfil del usuario
           get(/databases/$(database)/documents/users/$(userId)).data.showFollowing)
        );
        
        // 🔐 El seguidor solo puede crear follows públicos; las cuentas privadas requieren aprobación.
        allow create: if request.auth != null &&
                      canCreateFollowingDocument(userId, followedUserId);
        
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
      }

      match /followers/{followerId} {
        // ✅ CORREGIDA: Regla más permisiva para lectura de followers
        allow read: if request.auth != null && (
          request.auth.uid == userId || // El propietario ve todos sus seguidores
          (canViewContent(request.auth.uid, userId) && // ✅ Puedes ver el perfil del usuario
           get(/databases/$(database)/documents/users/$(userId)).data.get('showFollowers', true))
        );
        
        // 🔐 Solo las partes de la relación pueden crear el documento follower correspondiente.
        allow create: if request.auth != null &&
                      canCreateFollowerDocument(userId, followerId);
        
        // El owner puede borrar seguidores para soportar "Suprimir" desde la lista.
        allow delete: if request.auth != null && (request.auth.uid == followerId || request.auth.uid == userId);
        allow update: if request.auth != null && (request.auth.uid == followerId || request.auth.uid == userId);
      }

      match /mutuals/{mutualUserId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          (canViewContent(request.auth.uid, userId) &&
           get(/databases/$(database)/documents/users/$(userId)).data.get('showMutuals', true))
        );

        // Solo Cloud Functions crean/actualizan mutuals; el cliente puede borrar al unfollow.
        allow create, update: if false;
        allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == mutualUserId);
      }

      // SISTEMA DE SOLICITUDES DE SEGUIMIENTO
      match /sentFollowRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // ✅ CORREGIDA: Solo permitir enviar solicitudes a cuentas activas
        allow create: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.data.recipientId is string &&
                      canFollowUser(userId, request.resource.data.recipientId);
        // ✅ CORREGIDA: Permitir que tanto el remitente como el destinatario actualicen
        // (necesario para el sistema de aceptación/rechazo de solicitudes)
        allow update: if request.auth != null && (
          request.auth.uid == userId || // El remitente puede actualizar
          request.auth.uid == resource.data.recipientId // El destinatario puede actualizar
        );
        // ✅ CORREGIDA: Permitir que tanto el remitente como el destinatario eliminen
        // (necesario para el sistema de limpieza de solicitudes)
        allow delete: if request.auth != null && (
          request.auth.uid == userId || // El remitente puede eliminar
          request.auth.uid == resource.data.recipientId // El destinatario puede eliminar
        );
      }

      match /receivedFollowRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // ✅ CORREGIDA: Permitir que cualquier usuario autenticado cree solicitudes
        // (necesario para el sistema de solicitudes de seguimiento)
        allow create: if request.auth != null &&
                      request.resource.data.recipientId == userId &&
                      request.resource.data.senderId == request.auth.uid &&
                      canFollowUser(request.auth.uid, userId);
        // ✅ CORREGIDA: Permitir que tanto el remitente como el destinatario actualicen
        // (necesario para el sistema de aceptación/rechazo de solicitudes)
        allow update: if request.auth != null && (
          request.auth.uid == userId || // El destinatario puede actualizar
          request.auth.uid == resource.data.senderId // El remitente puede actualizar
        );
        // Remitente o destinatario pueden eliminar (cancelación / rechazo / aceptación)
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid == resource.data.senderId
        );
      }

      // ✅ ACTUALIZADO: Reglas para listas de audiencia personalizada
      match /customAudienceLists/{listId} {
        // ✅ PERMITIR LECTURA LIMITADA: Solo para verificar membresía en content visibility
        allow read: if request.auth != null && (
          // El propietario puede leer todas sus listas
          request.auth.uid == userId ||
          // Otros usuarios pueden leer SOLO para verificar si están en la lista
          // (esto es necesario para las security rules de contenido)
          request.auth.uid != null
        );

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasAll(['name', 'members', 'createdAt'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 50
                      && request.resource.data.members is list
                      && request.resource.data.members.size() <= 100
                      && request.resource.data.createdAt is timestamp
                      && (!("description" in request.resource.data) || request.resource.data.description is string)
                      && (!("color" in request.resource.data) || request.resource.data.color is string)
                      && (!("icon" in request.resource.data) || request.resource.data.icon is string)
                      && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 50
                      && request.resource.data.members is list
                      && request.resource.data.members.size() <= 100
                      && (!("description" in request.resource.data) || request.resource.data.description is string)
                      && (!("color" in request.resource.data) || request.resource.data.color is string)
                      && (!("icon" in request.resource.data) || request.resource.data.icon is string)
                      && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);

        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Reglas para audiencias personalizadas de contenido específico
      match /customAudiences/{audienceId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasAll(['contentType', 'allowedUsers', 'createdAt'])
                      && request.resource.data.contentType in ['moment', 'story']
                      && request.resource.data.allowedUsers is list
                      && request.resource.data.allowedUsers.size() <= 100
                      && request.resource.data.createdAt is timestamp;

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.contentType == resource.data.contentType
                      && request.resource.data.allowedUsers is list
                      && request.resource.data.allowedUsers.size() <= 100;

        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // ✅ ACTUALIZADO: Reglas mejoradas para momentos con configuración avanzada
      match /moments/{momentId} {
        allow read: if request.auth != null &&
                      canViewContentWithAudience(
                        request.auth.uid,
                        userId,
                        resource.data.get('audience', 'everyone'),
                        'moment',
                        momentId,
                        resource.data.get('customListId', '')
                      );

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                      && request.resource.data.authorId == userId
                      && (!("audience" in request.resource.data) ||
                          request.resource.data.audience in ['everyone', 'mutuals', 'bestFriends', 'custom', 'customList', 'onlyMe'])
                      && (!("customViewers" in request.resource.data) ||
                          request.resource.data.customViewers is list)
                      && (!("customListId" in request.resource.data) ||
                          request.resource.data.customListId is string)
                      && (!("customListName" in request.resource.data) ||
                          request.resource.data.customListName is string)
                      // ✅ NUEVAS VALIDACIONES: Campos de configuración avanzada
                      && (!("disableComments" in request.resource.data) ||
                          request.resource.data.disableComments is bool)
                      && (!("hideLikeCounts" in request.resource.data) ||
                          request.resource.data.hideLikeCounts is bool)
                      && (!("allowSharing" in request.resource.data) ||
                          request.resource.data.allowSharing is bool)
                      && (!("hasHiddenLayers" in request.resource.data) ||
                          request.resource.data.hasHiddenLayers is bool)
                      && (!("hiddenLayerCount" in request.resource.data) ||
                          request.resource.data.hiddenLayerCount is int)
                      // ✅ NUEVA VALIDACIÓN: Campo de coordenadas de ubicación
                      && (!("locationCoordinate" in request.resource.data) ||
                          (request.resource.data.locationCoordinate is map &&
                           request.resource.data.locationCoordinate.latitude is number &&
                           request.resource.data.locationCoordinate.longitude is number))

        allow update: if request.auth != null && (
          request.auth.uid == userId ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastActivity']) &&
           canViewContentWithAudience(request.auth.uid, userId, resource.data.get('audience', 'everyone'), 'moment', momentId, resource.data.get('customListId', ''))) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
           canViewContentWithAudience(request.auth.uid, userId, resource.data.get('audience', 'everyone'), 'moment', momentId, resource.data.get('customListId', '')))
        );

        allow delete: if request.auth != null && request.auth.uid == userId;

        match /hiddenLayers/{layerId} {
          allow read: if request.auth != null &&
                         canViewContentWithAudience(
                           request.auth.uid,
                           userId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                           'moment',
                           momentId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                         );

          allow create, update: if request.auth != null &&
                                   request.auth.uid == userId &&
                                   request.resource.data.id is string &&
                                   request.resource.data.type in ['text', 'audio', 'image'] &&
                                   request.resource.data.anchorX is number &&
                                   request.resource.data.anchorY is number &&
                                   request.resource.data.width is number &&
                                   request.resource.data.height is number &&
                                   request.resource.data.shape in ['circle', 'roundedRect'] &&
                                   request.resource.data.zIndex is int &&
                                   (!('text' in request.resource.data) || request.resource.data.text is string) &&
                                   (!('mediaURL' in request.resource.data) || request.resource.data.mediaURL is string) &&
                                   (!('thumbnailURL' in request.resource.data) || request.resource.data.thumbnailURL is string) &&
                                   (!('duration' in request.resource.data) || request.resource.data.duration is number) &&
                                   (!('caption' in request.resource.data) || request.resource.data.caption is string) &&
                                   (!('imageOffsetX' in request.resource.data) || request.resource.data.imageOffsetX is number) &&
                                   (!('imageOffsetY' in request.resource.data) || request.resource.data.imageOffsetY is number) &&
                                   (!('imageScale' in request.resource.data) || request.resource.data.imageScale is number) &&
                                   (!('imageFrameStyle' in request.resource.data) || request.resource.data.imageFrameStyle in ['classic', 'clean', 'vintage']) &&
                                   (!('textStyle' in request.resource.data) || request.resource.data.textStyle in ['clean', 'serif', 'handwritten', 'mono', 'bubble', 'editorial']) &&
                                   (!('presentationStyle' in request.resource.data) || request.resource.data.presentationStyle in ['glassCard', 'captionPill', 'paperNote', 'markerLabel', 'floatingQuote', 'minimalText']) &&
                                   (!('unlockMode' in request.resource.data) || request.resource.data.unlockMode in ['immediate', 'scheduled']) &&
                                   (!('unlockAt' in request.resource.data) || request.resource.data.unlockAt is timestamp) &&
                                   (!('authorTimezoneIdentifier' in request.resource.data) || request.resource.data.authorTimezoneIdentifier is string) &&
                                   (!('moderationState' in request.resource.data) || request.resource.data.moderationState in ['visible', 'hidden', 'pending']);

          allow delete: if request.auth != null && request.auth.uid == userId;

          match /discoveries/{viewerId} {
            allow read: if request.auth != null && request.auth.uid == userId;

            allow create, update: if request.auth != null &&
                                     request.auth.uid == viewerId &&
                                     canViewContentWithAudience(
                                       request.auth.uid,
                                       userId,
                                       get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                                       'moment',
                                       momentId,
                                       get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                                     ) &&
                                     request.resource.data.viewerId == viewerId &&
                                     (!('username' in request.resource.data) || request.resource.data.username is string) &&
                                     (!('profileImagePath' in request.resource.data) || request.resource.data.profileImagePath is string) &&
                                     request.resource.data.discoveredAt is timestamp;

            allow delete: if false;
          }
        }

        match /hiddenLayerDiscoverers/{viewerId} {
          allow read: if request.auth != null && request.auth.uid == userId;

          allow create, update: if request.auth != null &&
                                   request.auth.uid == viewerId &&
                                   canViewContentWithAudience(
                                     request.auth.uid,
                                     userId,
                                     get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                                     'moment',
                                     momentId,
                                     get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                                   ) &&
                                   request.resource.data.viewerId == viewerId &&
                                   (!('username' in request.resource.data) || request.resource.data.username is string) &&
                                   (!('profileImagePath' in request.resource.data) || request.resource.data.profileImagePath is string) &&
                                   request.resource.data.lastDiscoveredAt is timestamp;

          allow delete: if false;
        }

        // ✅ ACTUALIZADO: Comentarios con validación de configuración avanzada
        match /comments/{commentId} {
          allow read: if request.auth != null &&
                         canViewContentWithAudience(
                           request.auth.uid,
                           userId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                           'moment',
                           momentId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                         );

          // ✅ NUEVO: Solo permitir crear comentarios si NO están deshabilitados
          allow create: if request.auth != null &&
                          request.resource.data.authorId == request.auth.uid &&
                          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) &&
                          // ✅ VALIDAR: Comentarios habilitados en el momento
                          get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('disableComments', false) == false &&
                           canViewContentWithAudience(
                             request.auth.uid,
                             userId,
                             get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                             'moment',
                             momentId,
                             get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                           );

          allow update: if request.auth != null && (
            request.auth.uid == resource.data.authorId ||
            (canViewContentWithAudience(
               request.auth.uid,
               userId,
               get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
               'moment',
               momentId,
               get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
             ) &&
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'metadata']) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metadata'])))
          );

          allow delete: if request.auth != null &&
                          (request.auth.uid == userId || request.auth.uid == resource.data.authorId);
        }

        // ✅ ACTUALIZADO: Reacciones con validación de configuración avanzada
        match /reactions/{reactionId} {
          allow read: if request.auth != null &&
                         canViewContentWithAudience(
                           request.auth.uid,
                           userId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                           'moment',
                           momentId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                         );

          // ✅ NUEVO: Solo permitir reacciones si NO están ocultos los likes
          allow create: if request.auth != null
                        && request.resource.data.userId == request.auth.uid
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                        && canViewContentWithAudience(
                              request.auth.uid,
                              userId,
                              get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                              'moment',
                              momentId,
                              get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                            )
                        && request.resource.data.keys().hasAll(['userId', 'reactionType', 'timestamp'])
                        && request.resource.data.userId is string
                        && request.resource.data.reactionType is string
                        && request.resource.data.reactionType in ['vibe', 'fire', 'real', 'mood', 'glow', 'feel', 'love', 'wow', 'laugh', 'cry', 'respect', 'power', 'genius', 'creative', 'chill', 'hype']
                        && request.resource.data.timestamp is timestamp;

          allow update: if request.auth != null && request.auth.uid == resource.data.userId;

          allow delete: if request.auth != null && (
            request.auth.uid == userId ||
            request.auth.uid == resource.data.userId
          );
        }

        // ✅ ACTUALIZADO: Likes legacy con validación de configuración avanzada
        match /likes/{likeId} {
          allow read: if request.auth != null &&
                         canViewContentWithAudience(
                           request.auth.uid,
                           userId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                           'moment',
                           momentId,
                           get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                         );

          // ✅ NUEVO: Solo permitir likes si NO están ocultos los conteos
          allow create: if request.auth != null
                        && request.resource.data.userId == request.auth.uid
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                        && canViewContentWithAudience(
                              request.auth.uid,
                              userId,
                              get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('audience', 'everyone'),
                              'moment',
                              momentId,
                              get(/databases/$(database)/documents/users/$(userId)/moments/$(momentId)).data.get('customListId', '')
                            );

          allow update: if request.auth != null && request.auth.uid == resource.data.userId;

          allow delete: if request.auth != null && (
            request.auth.uid == userId ||
            request.auth.uid == resource.data.userId
          );
        }
      }

      // ✅ ACTUALIZADO: Reglas mejoradas para historias con audiencia personalizada
      match /stories/{storyId} {
        allow read: if request.auth != null &&
                      canViewContentWithAudience(
                        request.auth.uid,
                        userId,
                        resource.data.get('audience', 'everyone'),
                        'story',
                        storyId,
                        resource.data.get('customListId', '')
                      );

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                      && request.resource.data.authorId == userId
                      && (!("audience" in request.resource.data) ||
                          request.resource.data.audience in ['everyone', 'mutuals', 'bestFriends', 'custom', 'customList', 'onlyMe'])
                      && (!("customViewers" in request.resource.data) ||
                          request.resource.data.customViewers is list)
                      && (!("customListId" in request.resource.data) ||
                          request.resource.data.customListId is string)
                      && (!("customListName" in request.resource.data) ||
                          request.resource.data.customListName is string)
                      && (!("expirationHours" in request.resource.data) ||
                          request.resource.data.expirationHours in [24, 48])
                      && request.resource.data.keys().hasAll(['authorId', 'mediaItem'])
                      && request.resource.data.authorId is string
                      && request.resource.data.mediaItem is map
                      && request.resource.data.mediaItem.url is string
                      // ✅ NUEVO: Validación para stickers
                      && (!("stickers" in request.resource.data) ||
                         request.resource.data.stickers is list)
                          && (!("aspectRatio" in request.resource.data) ||
                           request.resource.data.aspectRatio is string)
                          && (!("backgroundFrameURL" in request.resource.data) ||
                             request.resource.data.backgroundFrameURL is string)
                      // 🔗 STORY CHAINS: Validación para cadenas de historias
                      && (!("chainId" in request.resource.data) ||
                          (request.resource.data.chainId is string &&
                           request.resource.data.chainId.size() > 0 &&
                           request.resource.data.chainPosition is int &&
                           request.resource.data.chainPosition > 0 &&
                           request.resource.data.chainTitle is string &&
                           request.resource.data.chainTitle.size() > 0))
                      && (!("chainPosition" in request.resource.data) ||
                          (request.resource.data.chainPosition is int &&
                           request.resource.data.chainPosition > 0))
                      && (!("chainTitle" in request.resource.data) ||
                          (request.resource.data.chainTitle is string &&
                           request.resource.data.chainTitle.size() > 0))
                      // 🔗 STORY CHAINS: Validación para configuración de continuación
                      && (!("allowOthersToContinue" in request.resource.data) ||
                          request.resource.data.allowOthersToContinue is bool)
                      && (!("continuationAudience" in request.resource.data) ||
                          request.resource.data.continuationAudience in ['everyone', 'mutuals', 'bestFriends', 'custom', 'customList'])
                      && (!("continuationCustomViewers" in request.resource.data) ||
                          request.resource.data.continuationCustomViewers is list)
                      && (!("continuationCustomListId" in request.resource.data) ||
                          request.resource.data.continuationCustomListId is string)
                      && (!("continuationCustomListName" in request.resource.data) ||
                          request.resource.data.continuationCustomListName is string);

        allow update: if request.auth != null && (
          request.auth.uid == userId ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expirationDate']) &&
           request.resource.data.expirationDate is timestamp)
        );
        allow delete: if request.auth != null && request.auth.uid == userId;

        // ✅ CORREGIDO: Reglas para la subcolección de vistas
        match /viewers/{viewerId} {
          allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == viewerId);
          
          // Permite crear o sobrescribir una vista si el usuario puede ver la historia
          allow write: if request.auth != null &&
                         request.auth.uid == viewerId &&
                         get(/databases/$(database)/documents/users/$(viewerId)).data.get('isActive', true) &&
                         canViewContentWithAudience(
                           request.auth.uid,
                           userId,
                           get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('audience', 'everyone'),
                           'story',
                           storyId,
                           get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('customListId', '')
                         );
        }

        // Reacciones en historias
        match /reactions/{reactionId} {
          allow read: if request.auth != null;

          // ✅ SIMPLIFICADO: Para historias usar 'reaction' (emoji)
          allow create: if request.auth != null
                        && request.resource.data.userId == request.auth.uid
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                        // ✅ Para historias: usar 'reaction' para emojis
                        && request.resource.data.keys().hasAll(['userId', 'reaction', 'timestamp'])
                        && request.resource.data.userId is string
                        && request.resource.data.reaction is string
                        && request.resource.data.reaction.size() > 0
                        && request.resource.data.reaction.size() <= 32
                        && request.resource.data.timestamp is timestamp;

          allow update: if request.auth != null && request.auth.uid == resource.data.userId;

          allow delete: if request.auth != null && (
            request.auth.uid == userId ||
            request.auth.uid == resource.data.userId
          );
        }

        // ✅ POLL STICKERS: metadata del sticker + votos por usuario
        match /pollVotes/{pollStickerId} {
          // Metadata del poll: legible por quien pueda ver la story
          allow read: if request.auth != null &&
                         canViewContentWithAudience(
                           request.auth.uid,
                           userId,
                           get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('audience', 'everyone'),
                           'story',
                           storyId,
                           get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('customListId', '')
                         );

          // Solo el autor crea/actualiza metadata agregada del poll
          allow create, update: if request.auth != null
                                && request.auth.uid == userId;

          allow delete: if false;

          match /votes/{viewerId} {
            allow read: if request.auth != null && request.auth.uid == userId;

            allow create: if request.auth != null
                          && request.auth.uid == viewerId
                          && request.resource.data.userId == request.auth.uid
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                          && canViewContentWithAudience(
                               request.auth.uid,
                               userId,
                               get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('audience', 'everyone'),
                               'story',
                               storyId,
                               get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('customListId', '')
                             )
                          && request.resource.data.keys().hasAll(['userId', 'option', 'timestamp'])
                          && request.resource.data.userId is string
                          && request.resource.data.option is int
                          && request.resource.data.option >= 0
                          && request.resource.data.option <= 1
                          && request.resource.data.timestamp is timestamp;

            allow update, delete: if false;
          }
        }
        
        // ✅ QUESTION STICKERS: metadata del sticker + respuestas recibidas
        match /questionResponses/{questionStickerId} {
            // Metadata del sticker de preguntas: solo el autor de la historia
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create, update: if request.auth != null
                                  && request.auth.uid == userId;
            allow delete: if false;

            match /responses/{responseId} {
              // Solo el autor de la historia puede leer las respuestas recibidas
              allow read: if request.auth != null && request.auth.uid == userId;

              // Cualquier usuario autenticado y activo que pueda ver la story puede enviar una pregunta
              allow create: if request.auth != null
                            && request.resource.data.userId == request.auth.uid
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                            && canViewContentWithAudience(
                                 request.auth.uid,
                                 userId,
                                 get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('audience', 'everyone'),
                                 'story',
                                 storyId,
                                 get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('customListId', '')
                               )
                            && request.resource.data.keys().hasAll(['userId', 'response', 'timestamp', 'isAnonymous'])
                            && request.resource.data.userId is string
                            && request.resource.data.response is string
                            && request.resource.data.response.size() > 0
                            && request.resource.data.response.size() <= 500
                            && request.resource.data.timestamp is timestamp
                            && request.resource.data.isAnonymous is bool;

              allow update, delete: if false;
            }
        }

        match /emojiSliders/{stickerId} {
          allow read: if request.auth != null &&
                         canViewContentWithAudience(
                           request.auth.uid,
                           userId,
                           get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('audience', 'everyone'),
                           'story',
                           storyId,
                           get(/databases/$(database)/documents/users/$(userId)/stories/$(storyId)).data.get('customListId', '')
                         );

          allow create: if request.auth != null
                        && request.auth.uid == userId
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                        && request.resource.data.keys().hasAll(['stickerId', 'prompt', 'emoji', 'createdAt'])
                        && request.resource.data.stickerId is string
                        && request.resource.data.prompt is string
                        && request.resource.data.emoji is string
                        && request.resource.data.createdAt is timestamp;

          allow update, delete: if request.auth != null && request.auth.uid == userId;

          match /votes/{viewerId} {
            allow read: if request.auth != null;

            allow create: if request.auth != null
                          && request.auth.uid == viewerId
                          && request.resource.data.userId == request.auth.uid
                          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                          && request.resource.data.keys().hasAll(['userId', 'value', 'timestamp'])
                          && request.resource.data.userId is string
                          && request.resource.data.value is number
                          && request.resource.data.value >= 0
                          && request.resource.data.value <= 1
                          && request.resource.data.timestamp is timestamp;

            allow update, delete: if false;
          }
        }

        // ✅ NUEVO: Interacciones genéricas de stickers (Quiz, etc)
        match /stickerInteractions/{interactionId} {
          allow read: if request.auth != null;

          // ✅ SIMPLIFICADO: Permitir guardar interacciones si el usuario está activo
          allow write: if request.auth != null &&
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true);
        }
      }

      match /highlights/{highlightId} {
        allow read: if request.auth != null && canViewContent(request.auth.uid, userId);
        allow create: if request.auth != null &&
                      request.auth.uid == userId &&
                      get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        
        // ✅ NUEVO: Reglas para la subcolección de historias en highlights
        match /stories/{storyId} {
          allow read: if request.auth != null && canViewContent(request.auth.uid, userId);
          allow create: if request.auth != null &&
                        request.auth.uid == userId &&
                        get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true);
          allow update: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      // LEGACY: colecciones retiradas del grafo social
      match /connections/{targetUserDocId} {
        allow read, write: if false;
      }

      match /admirers/{admirerDocId} {
        allow read, write: if false;
      }

      match /visits/{visitId} {
        allow list: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid != userId
        );
        
        allow get: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid == resource.data.visitorId
        );
        
        allow create: if request.auth != null &&
                       request.resource.data.visitorId == request.auth.uid &&
                       request.resource.data.visitorId != userId &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) &&
                       request.resource.data.keys().hasAll(['visitorId', 'timestamp']) &&
                       request.resource.data.visitorId is string &&
                       request.resource.data.timestamp is timestamp;
        
        allow update: if request.auth != null &&
                       request.auth.uid == resource.data.visitorId &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true);
        
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid == resource.data.visitorId
        );
      }

      match /visitSummaries/{summaryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // ✅ NUEVO: Reglas para la subcolección de historial de la cuenta
      match /accountHistory/{historyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

        match /notifications/{notificationDocId} {
          allow read: if request.auth != null && request.auth.uid == userId;
  
          allow create: if request.auth != null && (
            // El usuario puede crear notificaciones para sí mismo
            request.auth.uid == userId ||
            // ✅ NUEVO: Permitir que usuarios autenticados creen notificaciones para otros
            // (reacciones, comentarios, menciones, etc.)
            (request.auth.uid != null &&
             request.resource.data.get('senderId', '') == request.auth.uid) ||
            // Notificaciones del sistema (appeals, suspensiones, etc.)
            (!("senderId" in request.resource.data) &&
             request.resource.data.get('type', '') in ['appeal_submitted', 'appeal_approved', 'appeal_denied', 'appeal_info_requested', 'appeal_under_review', 'appeal_escalated'])
          );
  
          allow update: if request.auth != null && request.auth.uid == userId;
          // ✅ CORREGIDA: Permitir que tanto el propietario como el remitente eliminen
          // (necesario para el sistema de limpieza de notificaciones de solicitudes)
          allow delete: if request.auth != null && (
            request.auth.uid == userId || // El propietario del perfil puede eliminar
            request.auth.uid == resource.data.senderId // El remitente puede eliminar
          );
        }

      match /savedMoments/{momentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
 
      // ✅ NUEVA: Reglas para la subcolección de contenidos eliminados temporalmente (Soft Delete)
      match /recentlyDeleted/{deletedId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false; // El contenido borrado no se edita, solo se restaura (delete + create original) o se borra definitivamente
      }

      // Estado de historias vistas por author (cache cross-device)
      match /storySeen/{authorId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.data.lastSeenAt is timestamp
                              && (!("updatedAt" in request.resource.data) ||
                                  request.resource.data.updatedAt is timestamp);

        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /dataExportRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.userEmail == request.auth.token.email;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /loginActivity/{activityId} {
        // Owner-only: reads, session/login merges (setData merge), and revoke-all (isActive=false).
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /dailyStats/{dateString} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /featureUsage/{dateString} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /userActivity/{activityId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if false;
      }

      match /accountAudit/{auditId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
        allow delete: if false;
      }
    }

    // =====================================================================
    // GLOBAL COLLECTIONS
    // =====================================================================

    match /reactions/{reactionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true);
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // GEMINI CONVERSATION SYSTEM
    match /geminiConversationTitles/{conversationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.userId
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                      && request.resource.data.keys().hasAll(['id', 'title', 'lastUpdated', 'messageCount', 'userId'])
                      && request.resource.data.id is string
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.lastUpdated is timestamp
                      && request.resource.data.messageCount is int
                      && request.resource.data.messageCount >= 0
                      && request.resource.data.userId is string;
      allow update: if request.auth != null
                      && request.auth.uid == resource.data.userId
                      && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /geminiConversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.userId
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                      && request.resource.data.keys().hasAll(['id', 'title', 'messages', 'createdAt', 'lastUpdated', 'userId'])
                      && request.resource.data.id is string
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.messages is list
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.lastUpdated is timestamp
                      && request.resource.data.userId is string;
      allow update: if request.auth != null
                      && request.auth.uid == resource.data.userId
                      && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ✅ ACTUALIZADA: Función para validar mensajes con support para view-once
    function isValidChatStoragePath(path, message) {
      return path is string
        && path.matches('^users/' + request.auth.uid + '/chat/' + message.conversationId + '/' + message.id + '/.+');
    }

    function isValidMessage(message) {
      return message.keys().hasAll(['id', 'conversationId', 'senderId', 'type', 'status', 'isRead', 'isDeleted', 'isViewed']) &&
             message.keys().hasOnly([
               'id', 'conversationId', 'senderId', 'type', 'status', 'isRead', 'isDeleted', 'isViewed',
               'isViewOnce', 'viewedBy', 'allowReplay', 'replayedBy', 'statusUpdatedAt',
               'content', 'mediaUrl', 'thumbnailUrl', 'mediaObjectPath', 'thumbnailObjectPath',
               'mediaEncryption', 'thumbnailEncryption', 'duration', 'audioWaveform', 'fileName', 'fileSize',
               'mediaWidth', 'mediaHeight', 'latitude', 'longitude', 'locationName', 'locationAddress',
               'isLiveLocation', 'liveLocationExpiresAt', 'liveLocationDuration', 'liveLocationStoppedAt',
               'liveLocationSessionId', 'locationUpdatedAt', 'replyTo', 'expirationDate',
               'storyReplyData', 'sharedMomentData', 'sharedStoryData', 'mediaBatchId',
               'textOverlayLive', 'textOverlays', 'stickers', 'drawingData',
               'isForwarded', 'starredBy', 'timestamp', 'isVanishModeMessage', 'vanishExpiresAt'
             ]) &&
             message.id is string &&
             message.id.matches('^[A-Za-z0-9_-]+$') &&
             message.conversationId is string &&
             message.conversationId.matches('^[A-Za-z0-9_-]+$') &&
             message.senderId is string &&
             message.senderId == request.auth.uid &&
             message.type in ['text', 'image', 'video', 'audio', 'location', 'file', 'gif', 'sticker', 'ephemeral', 'sharedMoment', 'sharedStory', 'viewOnceImage', 'viewOnceVideo', 'chatNotice'] &&
             message.status in ['sending', 'sent', 'delivered', 'read'] &&
             message.isRead is bool &&
             message.isDeleted is bool &&
             message.isViewed is bool &&
             (!("isViewOnce" in message) || message.isViewOnce is bool) &&
             (!('viewedBy' in message) || message.viewedBy is list) &&
             (!('allowReplay' in message) || message.allowReplay is bool) &&
             (!('replayedBy' in message) || message.replayedBy is list) &&
             (!('statusUpdatedAt' in message) || message.statusUpdatedAt is timestamp) &&
             (!('textOverlayLive' in message) || message.textOverlayLive is bool) &&
             (!('textOverlays' in message) || message.textOverlays is list) &&
             (!('stickers' in message) || message.stickers is list) &&
             (!('drawingData' in message) || message.drawingData is bytes) &&
             (!('audioWaveform' in message) ||
               (message.type == 'audio' && message.audioWaveform is list && message.audioWaveform.size() <= 64)) &&
             // ✅ NUEVO: campos opcionales de ubicación (fija + en vivo)
             (!('latitude' in message) || message.latitude is number) &&
             (!('longitude' in message) || message.longitude is number) &&
             (!('locationName' in message) || message.locationName is string) &&
             (!('locationAddress' in message) || message.locationAddress is string) &&
             (!('isLiveLocation' in message) || message.isLiveLocation is bool) &&
             (!('liveLocationExpiresAt' in message) || message.liveLocationExpiresAt is timestamp) &&
             (!('liveLocationDuration' in message) || message.liveLocationDuration is string) &&
             (!('liveLocationStoppedAt' in message) || message.liveLocationStoppedAt is timestamp) &&
             (!('liveLocationSessionId' in message) || message.liveLocationSessionId is string) &&
             (!('locationUpdatedAt' in message) || message.locationUpdatedAt is timestamp) &&
             (!('mediaObjectPath' in message) || isValidChatStoragePath(message.mediaObjectPath, message)) &&
             (!('thumbnailObjectPath' in message) || isValidChatStoragePath(message.thumbnailObjectPath, message)) &&
             (!('isForwarded' in message) || message.isForwarded is bool) &&
             (!('starredBy' in message) || message.starredBy is list) &&
             (!('isVanishModeMessage' in message) || message.isVanishModeMessage is bool) &&
             (!('vanishedFor' in message) || message.vanishedFor is list) &&
             (!('vanishExpiresAt' in message) || message.vanishExpiresAt is timestamp);
    }

    function onlyVanishModeFieldsUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vanishModeActive', 'vanishModeEnabledBy', 'vanishModeEnabledAt', 'vanishMessageTimer', 'vanishSettingsNoticeMessageId', 'vanishDisabledNoticeMessageId'
        ])
        && request.resource.data.vanishModeActive is bool
        && (
          !('vanishModeEnabledBy' in request.resource.data)
          || request.resource.data.vanishModeEnabledBy is string
        )
        && (
          !('vanishModeEnabledAt' in request.resource.data)
          || request.resource.data.vanishModeEnabledAt is timestamp
        )
        && (
          !('vanishMessageTimer' in request.resource.data)
          || request.resource.data.vanishMessageTimer in ['onceSeen', 'hours24', 'days7']
        )
        && (
          !('vanishSettingsNoticeMessageId' in request.resource.data)
          || request.resource.data.vanishSettingsNoticeMessageId is string
        )
        && (
          !('vanishDisabledNoticeMessageId' in request.resource.data)
          || request.resource.data.vanishDisabledNoticeMessageId is string
        );
    }

    function onlyVanishSettingsNoticeIdUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vanishSettingsNoticeMessageId'])
        && request.resource.data.vanishSettingsNoticeMessageId is string;
    }

    function onlyVanishDisabledNoticeIdUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vanishDisabledNoticeMessageId'])
        && (
          !('vanishDisabledNoticeMessageId' in request.resource.data)
          || request.resource.data.vanishDisabledNoticeMessageId is string
        );
    }

    function onlyVanishExpiresAtStampUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vanishExpiresAt'])
        && request.resource.data.vanishExpiresAt is timestamp
        && resource.data.get('isVanishModeMessage', false) == true
        && !('vanishExpiresAt' in resource.data);
    }

    function onlyChatNoticeContentUpdated() {
      return resource.data.type == 'chatNotice'
        && resource.data.senderId == request.auth.uid
        && request.resource.data.type == 'chatNotice'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content'])
        && request.resource.data.content is string
        && request.resource.data.content.matches('disappearing:.*');
    }

    function onlyVanishMessageTimerUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vanishMessageTimer'])
        && request.resource.data.vanishMessageTimer in ['onceSeen', 'hours24', 'days7'];
    }

    function onlyVanishedForMeUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vanishedFor'])
        && request.resource.data.vanishedFor is list
        && (
          (
            !(request.auth.uid in resource.data.get('vanishedFor', [])) &&
            request.auth.uid in request.resource.data.vanishedFor &&
            request.resource.data.vanishedFor.size() == resource.data.get('vanishedFor', []).size() + 1 &&
            request.resource.data.vanishedFor.hasAll(resource.data.get('vanishedFor', []))
          )
        );
    }

    function onlyStarredByFieldsUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starredBy'])
        && request.resource.data.starredBy is list
        && (
          (
            !(request.auth.uid in resource.data.get('starredBy', [])) &&
            request.auth.uid in request.resource.data.starredBy &&
            request.resource.data.starredBy.size() == resource.data.get('starredBy', []).size() + 1 &&
            request.resource.data.starredBy.hasAll(resource.data.get('starredBy', []))
          ) ||
          (
            request.auth.uid in resource.data.get('starredBy', []) &&
            !(request.auth.uid in request.resource.data.starredBy) &&
            request.resource.data.starredBy.size() + 1 == resource.data.get('starredBy', []).size() &&
            resource.data.get('starredBy', []).hasAll(request.resource.data.starredBy)
          )
        );
    }

    function onlyEditFieldsUpdated() {
      return resource.data.senderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
        && request.resource.data.editedAt is timestamp;
    }

    function onlyDeletedForMeUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
        && request.resource.data.deletedFor is list
        && (
          (
            !(request.auth.uid in resource.data.get('deletedFor', [])) &&
            request.auth.uid in request.resource.data.deletedFor &&
            request.resource.data.deletedFor.size() == resource.data.get('deletedFor', []).size() + 1 &&
            request.resource.data.deletedFor.hasAll(resource.data.get('deletedFor', []))
          ) ||
          (
            request.auth.uid in resource.data.get('deletedFor', []) &&
            !(request.auth.uid in request.resource.data.deletedFor) &&
            request.resource.data.deletedFor.size() + 1 == resource.data.get('deletedFor', []).size() &&
            resource.data.get('deletedFor', []).hasAll(request.resource.data.deletedFor)
          )
        );
    }

    function onlyConversationDeletedForMeUpdated() {
      return request.resource.data.deletedFor is list
        && (
          (
            !(request.auth.uid in resource.data.get('deletedFor', [])) &&
            request.auth.uid in request.resource.data.deletedFor &&
            request.resource.data.deletedFor.size() == resource.data.get('deletedFor', []).size() + 1 &&
            request.resource.data.deletedFor.hasAll(resource.data.get('deletedFor', []))
          ) ||
          (
            request.auth.uid in resource.data.get('deletedFor', []) &&
            !(request.auth.uid in request.resource.data.deletedFor) &&
            request.resource.data.deletedFor.size() + 1 == resource.data.get('deletedFor', []).size() &&
            resource.data.get('deletedFor', []).hasAll(request.resource.data.deletedFor)
          )
        );
    }

    function onlyConversationLastDeletedAtUpdated() {
      return request.resource.data.lastDeletedAt is map
        && (
          (!('lastDeletedAt' in resource.data) && request.resource.data.lastDeletedAt.keys().hasOnly([request.auth.uid])) ||
          (('lastDeletedAt' in resource.data) && request.resource.data.lastDeletedAt.diff(resource.data.lastDeletedAt).affectedKeys().hasOnly([request.auth.uid]))
        )
        && request.resource.data.lastDeletedAt[request.auth.uid] is timestamp;
    }

    function onlyConversationLastReadAtUpdated() {
      return request.resource.data.lastReadAt is map
        && (
          (!('lastReadAt' in resource.data) && request.resource.data.lastReadAt.keys().hasOnly([request.auth.uid])) ||
          (('lastReadAt' in resource.data) && request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid]))
        )
        && request.resource.data.lastReadAt[request.auth.uid] is timestamp;
    }

    function onlyConversationLastMessageSeenAtUpdated() {
      return (!('lastMessageSeenAt' in request.resource.data))
        || (
          request.resource.data.lastMessageSeenAt is map
          && (
            (!('lastMessageSeenAt' in resource.data) && request.resource.data.lastMessageSeenAt.keys().hasOnly([request.auth.uid]))
            || (('lastMessageSeenAt' in resource.data) && request.resource.data.lastMessageSeenAt.diff(resource.data.lastMessageSeenAt).affectedKeys().hasOnly([request.auth.uid]))
          )
          && request.resource.data.lastMessageSeenAt[request.auth.uid] is timestamp
        );
    }

    function onlyConversationLastMessageReactionUpdated() {
      return (!('lastMessageReaction' in request.resource.data))
        || (
          request.resource.data.lastMessageReaction is map
          && request.resource.data.lastMessageReaction.keys().hasAll(['messageId', 'emoji', 'byUserId'])
          && request.resource.data.lastMessageReaction.keys().hasOnly(['messageId', 'emoji', 'byUserId'])
          && request.resource.data.lastMessageReaction.messageId is string
          && request.resource.data.lastMessageReaction.messageId.size() > 0
          && request.resource.data.lastMessageReaction.emoji is string
          && request.resource.data.lastMessageReaction.emoji.size() > 0
          && request.resource.data.lastMessageReaction.byUserId is string
          && request.resource.data.lastMessageReaction.byUserId == request.auth.uid
        );
    }

    function onlyConversationReadStatusForMeUpdated() {
      return request.resource.data.readStatus is map
        && (
          (!('readStatus' in resource.data) && request.resource.data.readStatus.keys().hasOnly([request.auth.uid])) ||
          (('readStatus' in resource.data) && request.resource.data.readStatus.diff(resource.data.readStatus).affectedKeys().hasOnly([request.auth.uid]))
        )
        && request.resource.data.readStatus[request.auth.uid] is bool;
    }

    function onlyDeleteForEveryoneUpdated() {
      return resource.data.senderId == request.auth.uid
        && request.resource.data.isDeleted == true
        && request.resource.data.deletedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDeleted',
          'deletedAt',
          'content',
          'mediaUrl',
          'thumbnailUrl',
          'mediaObjectPath',
          'thumbnailObjectPath',
          'mediaEncryption',
          'thumbnailEncryption'
        ]);
    }

    function isValidMessageReaction(reaction, conversationId, messageId, userId) {
      return reaction.keys().hasAll(['conversationId', 'messageId', 'userId', 'emoji', 'timestamp'])
        && reaction.keys().hasOnly(['conversationId', 'messageId', 'userId', 'emoji', 'timestamp', 'processed', 'processedAt'])
        && reaction.conversationId == conversationId
        && reaction.messageId == messageId
        && reaction.userId == userId
        && reaction.emoji is string
        && reaction.emoji.size() > 0
        && reaction.emoji.size() <= 16
        && reaction.timestamp is timestamp
        && (!('processed' in reaction) || reaction.processed is bool)
        && (!('processedAt' in reaction) || reaction.processedAt is timestamp);
    }

    function clientCannotWriteReactionProcessedFields() {
      return !('processed' in request.resource.data)
        && !('processedAt' in request.resource.data);
    }

    function reactionProcessedFieldsUnchanged() {
      return (!('processed' in resource.data) || request.resource.data.get('processed', false) == resource.data.get('processed', false))
        && (!('processedAt' in resource.data) || request.resource.data.get('processedAt', null) == resource.data.get('processedAt', null));
    }

    function canReadMessageReactionDoc() {
      return request.auth != null
        && resource.data.conversationId is string
        && resource.data.conversationId != ''
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants
        && canParticipateInConversations(request.auth.uid);
    }

  function participantAllowsBuzz(prefs, participantId) {
    return !(participantId in prefs) || prefs[participantId] != false;
  }

  // Chat 1:1 — solo hay un destinatario distinto del remitente.
  function otherParticipantAllowsBuzz(conversationId, senderId) {
    let data = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    let prefs = data.get('buzzPreferences', {});
    let participants = data.participants;
    return participants.size() == 2
      && (
        (participants[0] == senderId && participantAllowsBuzz(prefs, participants[1]))
        || (participants[1] == senderId && participantAllowsBuzz(prefs, participants[0]))
      );
  }

    function onlyStatusFieldsUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead','status','isViewed','statusUpdatedAt','readBy']);
    }
    // status opcional: markViewOnceAsViewed a veces también marca read; la CF consume lo setea con admin.
    function onlyViewOnceFieldsUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isViewed','viewedBy','replayedBy','status']);
    }
    // ✅ NUEVO: actualización de ubicación en vivo por el remitente
    // Las coordenadas viajan cifradas dentro de `content`.
    function onlyLiveLocationFieldsUpdated() {
      return resource.data.type == 'location'
        && resource.data.get('isLiveLocation', false) == true
        && resource.data.senderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content','latitude','longitude','locationUpdatedAt','liveLocationStoppedAt']);
    }

    function isAutomaticCleanup() {
      return resource.data.type == 'ephemeral' &&
             resource.data.expirationDate != null &&
             resource.data.expirationDate < request.time &&
             request.resource.data.isDeleted == true &&
             request.resource.data.deletedAt != null;
    }

    function isViewOnceCleanup() {
      return resource.data.get('isViewOnce', false) == true &&
             resource.data.type in ['viewOnceImage', 'viewOnceVideo'] &&
             request.resource.data.isDeleted == true &&
             request.resource.data.deletedAt != null;
    }
    function timestampUnchanged() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny(['timestamp']);
    }

    match /{path=**}/messageReactions/{userId} {
      allow read: if canReadMessageReactionDoc();
    }

    // CONVERSATIONS (E2E)
    match /conversations/{conversationId} {
      allow read: if request.auth != null &&
                    request.auth.uid in resource.data.participants &&
                    canParticipateInConversations(request.auth.uid);

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && canParticipateInConversations(request.auth.uid)
        && request.resource.data.participants.size() >= 2
        && (!('encryptionKey' in request.resource.data) || request.resource.data.encryptionKey is string)
        && (!('encryptionKeyCreatedAt' in request.resource.data) || request.resource.data.encryptionKeyCreatedAt is timestamp)
        && (!('encryptionVersion' in request.resource.data) || request.resource.data.encryptionVersion is string)
        && (!('conversationKeyVersion' in request.resource.data) || request.resource.data.conversationKeyVersion is int)
        && (!('wrappedKeys' in request.resource.data) || request.resource.data.wrappedKeys is map);

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants &&
        canParticipateInConversations(request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageTime', 'lastMessageSenderId', 'lastMessageType',
          'lastMessageSeenAt', 'lastMessageReaction',
          'updatedAt', 'unreadCount', 'deletedFor', 'lastDeletedAt',
          'timestamp', 'readStatus', 'lastReadAt',
          'encryptionKey', 'encryptionKeyCreatedAt', 'encryptionVersion', 'conversationKeyVersion',
          'sharedEncryptionKey', 'keyMetadata',
          'wrappedKeys', 'forwardingPreferences', 'buzzPreferences',
          'vanishModeActive', 'vanishModeEnabledBy', 'vanishModeEnabledAt', 'vanishMessageTimer',
          'vanishSettingsNoticeMessageId', 'vanishDisabledNoticeMessageId',
          'mutedByUserIds', 'mutedByTimestamps'
        ]) &&
        (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedFor']) || onlyConversationDeletedForMeUpdated())
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastDeletedAt']) || onlyConversationLastDeletedAtUpdated())
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['timestamp']) || request.resource.data.timestamp is timestamp)
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readStatus']) || onlyConversationReadStatusForMeUpdated())
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReadAt']) || onlyConversationLastReadAtUpdated())
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageSeenAt']) || onlyConversationLastMessageSeenAtUpdated())
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageReaction']) || onlyConversationLastMessageReactionUpdated())
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['encryptionKey','encryptionKeyCreatedAt','encryptionVersion']) ||
           (request.resource.data.encryptionKey is string &&
            request.resource.data.encryptionKeyCreatedAt is timestamp &&
            request.resource.data.get('encryptionVersion','1.0') is string) ||
           (!('encryptionKey' in request.resource.data) &&
            !('encryptionKeyCreatedAt' in request.resource.data) &&
            request.resource.data.get('encryptionVersion','1.0') is string))
          &&
          // Claves legacy en claro: solo se permite eliminarlas, nunca escribirlas
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedEncryptionKey']) ||
           !('sharedEncryptionKey' in request.resource.data))
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['keyMetadata']) ||
           !('keyMetadata' in request.resource.data))
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['conversationKeyVersion']) ||
           (request.resource.data.conversationKeyVersion is int &&
            request.resource.data.conversationKeyVersion >= resource.data.get('conversationKeyVersion', 0)))
          &&
          (!('wrappedKeys' in request.resource.data)
           || (
             request.resource.data.wrappedKeys is map
             && ((!('wrappedKeys' in resource.data) && request.resource.data.wrappedKeys.keys().hasOnly(resource.data.participants))
                 || (('wrappedKeys' in resource.data)
                     && request.resource.data.wrappedKeys.diff(resource.data.wrappedKeys).affectedKeys().hasOnly(resource.data.participants)))
             && (! (request.auth.uid in request.resource.data.wrappedKeys)
                 || (
                   request.resource.data.wrappedKeys[request.auth.uid].keys().hasAll(['wrappedKey','senderPublicKey','recipientKeyId','wrappedBy'])
                   && request.resource.data.wrappedKeys[request.auth.uid].wrappedKey is string
                   && request.resource.data.wrappedKeys[request.auth.uid].senderPublicKey is string
                   && request.resource.data.wrappedKeys[request.auth.uid].recipientKeyId is string
                   && request.resource.data.wrappedKeys[request.auth.uid].wrappedBy is string
                   && (!('wrappedAt' in request.resource.data.wrappedKeys[request.auth.uid]) || request.resource.data.wrappedKeys[request.auth.uid].wrappedAt is timestamp)
                 )
             )
           )
          )
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['forwardingPreferences'])
           || (request.resource.data.forwardingPreferences is map
               && (!('forwardingPreferences' in resource.data)
                   || request.resource.data.forwardingPreferences.diff(resource.data.forwardingPreferences).affectedKeys().hasOnly([request.auth.uid]))
               && (!(request.auth.uid in request.resource.data.forwardingPreferences)
                   || request.resource.data.forwardingPreferences[request.auth.uid] is bool)))
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['buzzPreferences'])
           || (request.resource.data.buzzPreferences is map
               && (!('buzzPreferences' in resource.data)
                   || request.resource.data.buzzPreferences.diff(resource.data.buzzPreferences).affectedKeys().hasOnly([request.auth.uid]))
               && (!(request.auth.uid in request.resource.data.buzzPreferences)
                   || request.resource.data.buzzPreferences[request.auth.uid] is bool)))
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vanishModeActive','vanishModeEnabledBy','vanishModeEnabledAt','vanishMessageTimer','vanishSettingsNoticeMessageId','vanishDisabledNoticeMessageId'])
           || onlyVanishModeFieldsUpdated()
           || onlyVanishMessageTimerUpdated()
           || onlyVanishSettingsNoticeIdUpdated()
           || onlyVanishDisabledNoticeIdUpdated())
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mutedByUserIds'])
           || (request.resource.data.mutedByUserIds is list
               && (
                 (!(request.auth.uid in resource.data.get('mutedByUserIds', []))
                  && request.auth.uid in request.resource.data.mutedByUserIds
                  && request.resource.data.mutedByUserIds.size() == resource.data.get('mutedByUserIds', []).size() + 1
                  && request.resource.data.mutedByUserIds.hasAll(resource.data.get('mutedByUserIds', [])))
                 ||
                 ((request.auth.uid in resource.data.get('mutedByUserIds', []))
                  && !(request.auth.uid in request.resource.data.mutedByUserIds)
                  && request.resource.data.mutedByUserIds.size() + 1 == resource.data.get('mutedByUserIds', []).size()
                  && resource.data.get('mutedByUserIds', []).hasAll(request.resource.data.mutedByUserIds))
               )
           ))
          &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mutedByTimestamps'])
           || (request.resource.data.mutedByTimestamps is map
               && (
                 (!('mutedByTimestamps' in resource.data)
                  && request.resource.data.mutedByTimestamps.keys().hasOnly([request.auth.uid]))
                 ||
                 (('mutedByTimestamps' in resource.data)
                  && request.resource.data.mutedByTimestamps.diff(resource.data.mutedByTimestamps).affectedKeys().hasOnly([request.auth.uid]))
               )
               && (!(request.auth.uid in request.resource.data.mutedByTimestamps)
                   || request.resource.data.mutedByTimestamps[request.auth.uid] is timestamp)))
        );

      // Conversations are shared records; clients may hide them per user via
      // `deletedFor`, but only trusted backend code may hard-delete the document.
      allow delete: if false;

      match /{path=**}/messageReactions/{userId} {
        allow read: if canReadMessageReactionDoc();
      }

      match /buzzEvents/{buzzId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && canParticipateInConversations(request.auth.uid);

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && canParticipateInConversations(request.auth.uid)
          && request.resource.data.keys().hasOnly(['senderId', 'type', 'createdAt', 'expiresAt', 'intensity', 'clientNonce'])
          && request.resource.data.keys().hasAll(['senderId', 'type', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type == 'buzz'
          && otherParticipantAllowsBuzz(conversationId, request.auth.uid)
          && request.resource.data.createdAt is timestamp
          && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp)
          && (!('intensity' in request.resource.data) || request.resource.data.intensity == 'normal')
          && (!('clientNonce' in request.resource.data) || request.resource.data.clientNonce is string);

        allow update, delete: if false;
      }

      // messages
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && canParticipateInConversations(request.auth.uid);

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isValidMessage(request.resource.data);

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && (
            onlyStatusFieldsUpdated()
            || onlyViewOnceFieldsUpdated()
            || onlyLiveLocationFieldsUpdated()
            || onlyStarredByFieldsUpdated()
            || onlyEditFieldsUpdated()
            || onlyDeletedForMeUpdated()
            || onlyVanishedForMeUpdated()
            || onlyDeleteForEveryoneUpdated()
            || onlyVanishExpiresAtStampUpdated()
            || onlyChatNoticeContentUpdated()
            || isAutomaticCleanup()
            || isViewOnceCleanup()
          )
          && timestampUnchanged()
          && (!('statusUpdatedAt' in request.resource.data) || request.resource.data.statusUpdatedAt is timestamp);

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        match /messageReactions/{userId} {
          allow read: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && canParticipateInConversations(request.auth.uid);

          allow create: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && canParticipateInConversations(request.auth.uid)
            && clientCannotWriteReactionProcessedFields()
            && isValidMessageReaction(request.resource.data, conversationId, messageId, userId);

          allow update: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && canParticipateInConversations(request.auth.uid)
            && reactionProcessedFieldsUnchanged()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji', 'timestamp'])
            && isValidMessageReaction(request.resource.data, conversationId, messageId, userId);

          allow delete: if request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
            && canParticipateInConversations(request.auth.uid);
        }
      }

      // typing
      match /typing/{userId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          canParticipateInConversations(request.auth.uid);
        allow create, update: if request.auth != null &&
          request.auth.uid == userId &&
          canParticipateInConversations(request.auth.uid) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow delete: if request.auth != null &&
          request.auth.uid == userId &&
          canParticipateInConversations(request.auth.uid) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // REPORTES Y OTROS
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.reporterId ||
        (!("reporterId" in request.resource.data) &&
         request.resource.data.get('type', '') == 'auto_moderation')
      ) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true);
      allow update: if false;
      allow delete: if false;
    }

    match /moderationLogs/{logId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /mediaModerationLogs/{logId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /moderationReviewQueue/{queueId} {
      allow create: if request.auth != null
                    && request.resource.data.userId is string
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.contentId is string
                    && request.resource.data.contentType is string
                    && request.resource.data.moderationScope is string
                    && request.resource.data.reason is string
                    && request.resource.data.category is string
                    && request.resource.data.status == 'pending';
      allow read: if request.auth != null
                  && request.auth.uid == "k95S89DDEMOSiwdX3W8cvwnUj7C3";
      allow update: if false;
      allow delete: if false;
    }

    match /moderationSettings/{settingsId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderador'];
    }

    match /appeals/{appealId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuspended', false) == true
                    && request.resource.data.keys().hasAll(['userId', 'ticketNumber', 'status', 'appealMessage', 'submittedAt'])
                    && request.resource.data.userId is string
                    && request.resource.data.ticketNumber is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.appealMessage is string
                    && request.resource.data.appealMessage.size() >= 50
                    && request.resource.data.appealMessage.size() <= 2000
                    && request.resource.data.submittedAt is timestamp
                    && (!("additionalInfo" in request.resource.data) || request.resource.data.additionalInfo is string)
                    && (!("attachments" in request.resource.data) ||
                        (request.resource.data.attachments is list && request.resource.data.attachments.size() <= 5))
                    && (!("contactEmail" in request.resource.data) || request.resource.data.contactEmail is string)
                    && (!("priority" in request.resource.data) || request.resource.data.priority in ['high', 'medium', 'low']);

      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      allow update: if false;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /appealAuditLogs/{logId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['type', 'appealId', 'timestamp'])
                    && request.resource.data.type is string
                    && request.resource.data.appealId is string
                    && request.resource.data.timestamp is timestamp;
      allow update: if false;
      allow delete: if false;
    }

    match /appealNotificationQueue/{notificationId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    match /scheduledDeletions/{requestId} {
      allow read: if false;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /emailQueue/{emailId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

        match /ephemeralResponses/{responseId} {
      allow read: if request.auth != null
                    && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId)
                    && canParticipateInConversations(request.auth.uid);
      
      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderId
                      && canParticipateInConversations(request.auth.uid);
      
      allow update: if false;
      
      allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId)
                      && canParticipateInConversations(request.auth.uid);
    }

    // ✅ SISTEMA DE SOLICITUDES DE MENSAJES
    match /messageRequests/{requestId} {
      allow read, list: if request.auth != null
                          && (request.auth.uid == resource.data.senderId ||
                              request.auth.uid == resource.data.receiverId)
                          && canParticipateInConversations(request.auth.uid);

      allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderId
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.receiverId is string
                      && request.resource.data.receiverId != ''
                      && request.resource.data.receiverId != request.auth.uid
                      && request.resource.data.message is string
                      && request.resource.data.status == 'pending'
                      && request.resource.data.messageType is string
                      && request.resource.data.timestamp is timestamp
                      && canParticipateInConversations(request.auth.uid)
                      && canParticipateInConversations(request.resource.data.receiverId)
                      // ✅ Política de solicitudes del receptor: everyone | following | nobody
                      && (
                        get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.get('messageRequestPolicy', 'everyone') == 'everyone' ||
                        (
                          get(/databases/$(database)/documents/users/$(request.resource.data.receiverId)).data.get('messageRequestPolicy', 'everyone') == 'following' &&
                          exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId)/following/$(request.auth.uid))
                        )
                      );

      allow update: if request.auth != null
                      && request.auth.uid == resource.data.senderId
                      && resource.data.createdBy == resource.data.senderId
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.receiverId == resource.data.receiverId
                      && request.resource.data.status == resource.data.status
                      && resource.data.status == 'pending'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'message',
                        'messageType',
                        'mediaUrl',
                        'thumbnailUrl',
                        'timestamp'
                      ])
                      && request.resource.data.message is string
                      && request.resource.data.messageType is string
                      && request.resource.data.timestamp is timestamp
                      && canParticipateInConversations(request.auth.uid);

      allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.senderId ||
                          request.auth.uid == resource.data.receiverId)
                      && canParticipateInConversations(request.auth.uid);
    }

    match /globalExportRequests/{requestId} {
      allow read: if false;
      allow create: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true);
      allow update: if false;
      allow delete: if false;
    }

        match /usernames/{username} {
            allow read: if true;
            allow create: if request.auth != null
                && request.auth.uid == request.resource.data.userId
                // ✅ ACTUALIZADO: email es opcional (no se incluye en cambio de username)
                && (!("email" in request.resource.data) || request.resource.data.email is string)
                && request.resource.data.userId is string;
    
            allow update: if request.auth != null
                && request.auth.uid == resource.data.userId
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true);
    
            allow delete: if request.auth != null
                && request.auth.uid == resource.data.userId;
        }

    match /interests/{interestId} {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }
    
    // 🔗 STORY CHAINS: Colección global para facilitar consultas de cadenas
    match /storyChains/{chainId} {
      allow read: if request.auth != null;
      
      allow create: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                    && request.resource.data.keys().hasAll(['id', 'title', 'createdBy', 'createdAt', 'partCount'])
                    && request.resource.data.id is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.createdBy is string
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.partCount is int
                    && request.resource.data.partCount == 1
                    && (!("description" in request.resource.data) ||
                        (request.resource.data.description is string &&
                         request.resource.data.description.size() <= 500))
                    && (!("tags" in request.resource.data) ||
                        (request.resource.data.tags is list &&
                         request.resource.data.tags.size() <= 10));
      
      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                    && (request.auth.uid == resource.data.createdBy ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partCount', 'lastUpdated', 'isExpired', 'expiredAt', 'lastPartBy', 'lastPartUsername']) &&
                         request.resource.data.partCount is int &&
                         request.resource.data.partCount > 0 &&
                         request.resource.data.lastUpdated is timestamp));
      
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    
    // 🌊 ECHOES: Momentos compartidos por ubicación en tiempo real
    match /echoes/{echoId} {
      // ✅ OPTIMIZADO: Verificar membresía usando el nuevo array plano participantIds
      // Esto permite consultas where('participantIds', 'array-contains', uid)
      function isParticipant(userId) {
         // Soporte dual: Nuevo campo (rápido) O fallback legacy (lento, solo lectura directa)
         return (userId in resource.data.participantIds) || 
                (resource.data.participants.size() > 0 && resource.data.participants[0].userId == userId); 
      }

      // Leer/Listar: Permitido si eres participante (usando participantIds es lo ideal)
      allow read, list: if request.auth != null && (
        resource.data.hostId == request.auth.uid || 
        request.auth.uid in resource.data.participantIds
      );

      // Crear: Cualquier usuario activo
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status in ['pending', 'active', 'expired', 'completed'];

      // Actualizar: Participantes pueden aceptar/rechazar (actualizar status)
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.hostId || request.auth.uid in resource.data.participantIds)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true);

      // Eliminar: Permite a los participantes (necesario si el último en salir no es el host)
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.hostId || request.auth.uid in resource.data.participantIds);
    }
    
    match /{path=**}/moments/{momentId} {
      allow get: if request.auth != null &&
                    canViewCollectionGroupContent(request.auth.uid, 'moment', momentId);
      
      // Keep collectionGroup list queries bounded and enforce the same
      // per-document audience checks required for direct reads.
      allow list: if request.auth != null &&
                     request.query.limit <= 500 &&
                     canViewCollectionGroupContent(request.auth.uid, 'moment', momentId);
    }
    
    // ✅ NUEVA: Regla para collectionGroup queries de historias (Story Chains)
    match /{path=**}/stories/{storyId} {
      allow get: if request.auth != null &&
                    canViewCollectionGroupContent(request.auth.uid, 'story', storyId);
      
      // Keep collectionGroup list queries bounded and enforce the same
      // per-document audience checks required for direct reads.
      allow list: if request.auth != null &&
                     request.query.limit <= 500 &&
                     canViewCollectionGroupContent(request.auth.uid, 'story', storyId);
    }
    
    // =====================================================================
        // 🔐 SYSTEM ENCRYPTION METRICS - MÉTRICAS DEL SISTEMA
        // =====================================================================

        // ✅ MÉTRICAS DE ENCRIPTACIÓN DEL SISTEMA
        match /encryption_metrics/{metricsId} {
          // Solo lectura para usuarios autenticados (admin panel)
          allow read: if request.auth != null;

          // Cualquier usuario autenticado puede crear métricas del sistema
          allow create: if request.auth != null
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                        && request.resource.data.timestamp is timestamp
                        && request.resource.data.keys().hasAll(['timestamp']);

          // No permitir actualización ni eliminación para mantener integridad
          allow update: if false;
          allow delete: if false;
        }

        // ✅ ESTADÍSTICAS DE KEYCHAIN DEL SISTEMA
        match /keychain_statistics/{statisticsId} {
          // Solo lectura para usuarios autenticados
          allow read: if request.auth != null;

          // Cualquier usuario autenticado puede crear estadísticas del sistema
          allow create: if request.auth != null
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                        && request.resource.data.timestamp is timestamp
                        && request.resource.data.keys().hasAll(['timestamp']);

          allow update: if false;
          allow delete: if false;
        }

        // ✅ REPORTES DE SALUD DEL SISTEMA DE ENCRIPTACIÓN
        match /encryption_health/{healthId} {
          // Solo lectura para usuarios autenticados
          allow read: if request.auth != null;

          // Cualquier usuario autenticado puede crear reportes de salud del sistema
          allow create: if request.auth != null
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)
                        && request.resource.data.timestamp is timestamp
                    && request.resource.data.keys().hasAll(['timestamp']);

          allow update: if false;
          allow delete: if false;
        }
    
   // ✅ NUEVA: Regla para collectionGroup queries de mensajes efímeros
   match /{path=**}/messages/{messageId} {
     allow read: if request.auth != null &&
       (resource.data.senderId == request.auth.uid ||
        (resource.data.conversationId != null &&
         request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true)));
   }
   
   // 🧠 NOVA MEMORY — facts document
   match /users/{userId}/novaMemory/memory {
     allow read: if request.auth != null && request.auth.uid == userId;

     allow create: if request.auth != null
                   && request.auth.uid == userId
                   && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                   && isValidNovaMemory(request.resource.data)
                   && isMemorySizeValid(request.resource.data);

     allow update: if request.auth != null
                   && request.auth.uid == userId
                   && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                   && isValidNovaMemory(request.resource.data)
                   && isMemorySizeValid(request.resource.data)
                   && canUpdateNovaMemory(userId);

     allow delete: if request.auth != null && request.auth.uid == userId;
   }

   // 🧠 NOVA MEMORY — rolling conversation summaries (ChatGPT-style context)
   match /users/{userId}/novaMemory/context {
     allow read: if request.auth != null && request.auth.uid == userId;

     allow create: if request.auth != null
                   && request.auth.uid == userId
                   && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                   && isValidNovaContext(request.resource.data)
                   && request.resource.data.userId == userId;

     allow update: if request.auth != null
                   && request.auth.uid == userId
                   && get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true)
                   && isValidNovaContext(request.resource.data)
                   && request.resource.data.userId == userId;

     allow delete: if request.auth != null && request.auth.uid == userId;
   }
  }
}
