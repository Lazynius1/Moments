/* Echo Info Sheet */
"echo.info.title" = "Was ist ein Echo";
"echo.info.what.title" = "Was es ist";
"echo.info.what.body" = "Echo ist ein gemeinsames Erlebnis rund um einen mit Ort markierten Moment. Es verbindet mehrere Perspektiven desselben Augenblicks zu einem visuellen Faden und öffnet sich erst, wenn mindestens 2 Teilnehmende zusagen.";
"echo.info.how.title" = "So funktioniert es";
"echo.info.how.body" = "Echo erkennt Momente von gegenseitigen Kontakten im selben Bereich (bis zu 500 m) und Zeitfenster (24 Std.). Sobald es aktiv ist, kannst du zwischen Perspektiven (untere Leiste) und Momenten (hoch/runter) wechseln.";
"echo.info.privacy.title" = "Privatsphäre";
"echo.info.privacy.body" = "Ein Echo wird zwischen gegenseitigen Kontakten erstellt, berücksichtigt aber, wer den Moment damals sehen durfte. Wenn sich die Beziehung später ändert, bleibt es sichtbar; verschwommen wird es nur, wenn die Zielgruppe des Moments (enge Freunde oder benutzerdefinierte Liste) dich nicht einschließt. In Echo siehst du deine Momente und die der Teilnehmenden, die zugesagt haben.";
"echo.info.status.title" = "Status";
"echo.info.status.body" = "Aktiv bedeutet, dass das Echo noch geöffnet ist und andere Personen während des 24-Stunden-Fensters noch beitreten können. Abgelaufen bedeutet, dass dieses Fenster beendet ist und sich das Echo schließt, sodass niemand mehr beitreten kann.";
"echo.info.controls.title" = "Steuerung";
"echo.info.controls.body" = "Wische nach oben oder unten, um Momente zu wechseln, nutze die untere Leiste für Perspektiven und das Menü, um das Echo zu verlassen. Solange ein Echo aktiv ist, kannst du es nicht verlassen: Das wird erst möglich, wenn das 24-Stunden-Fenster endet. Wenn du es verlässt, werden deine Momente aus diesem Echo entfernt.";

