"echo.info.status.body" = "Activo significa que el Echo sigue abierto y que otras personas todavía pueden unirse durante su ventana de 24 horas. Expirado significa que ese plazo ha terminado y que el Echo se cierra, así que nadie más puede unirse.";
"echo.info.controls.title" = "Controles";
