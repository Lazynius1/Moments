/* Privacy Policy */
"privacyPolicy.title" = "Política de privacitat";
"privacyPolicy.lastUpdated" = "Última actualització: 29 d'abril de 2026";
"privacyPolicy.section.summary.title" = "1. Resum";
"privacyPolicy.section.summary.body" = "Moments és una app social per compartir moments, històries, cadenes, missatges i converses amb Nova. No recopilem dades innecessàries ni construïm perfils comercials sobre tu.\n\nGuardem o processem la informació mínima que introdueixes, crees o actives mentre fas servir l'app, juntament amb dades tècniques necessàries perquè Moments funcioni, sigui segura, sincronitzi contingut, mostri anuncis quan correspongui i permeti usar Nova.";
"privacyPolicy.section.data.title" = "2. Informació que fas servir o generes a Moments";
"privacyPolicy.section.data.body" = "Quan crees un compte o configures el perfil, guardem dades com correu electrònic, nom d'usuari, foto de perfil, biografia, web, interessos, insígnies, estat en línia i preferències.\n\nQuan fas servir l'app, guardem el contingut i les accions que decideixes crear: moments, històries, cadenes, ecos, comentaris, reaccions, elements desats, visites, etiquetes, llistes personalitzades, millors amics i ajustos d'audiència.\n\nTambé tractem dades tècniques mínimes necessàries per a seguretat, sessió, sincronització, notificacions, anuncis i resolució d'errors.";
"privacyPolicy.section.use.title" = "3. Com fem servir les dades";
"privacyPolicy.section.use.body" = "Fem servir la informació per prestar el servei, autenticar-te, sincronitzar contingut, entregar missatges, aplicar els teus ajustos de privacitat, personalitzar l'experiència, millorar Moments, prevenir abusos, gestionar denúncies i complir obligacions legals.\n\nLes bases legals poden incloure la prestació del servei que demanes, el teu consentiment, el nostre interès legítim en seguretat i millora del producte, i el compliment d'obligacions legals.";
"privacyPolicy.section.nova.title" = "4. Nova i intel·ligència artificial";
"privacyPolicy.section.nova.body" = "Nova pot processar els teus missatges, imatges que li enviïs, context del teu compte, preferències, activitat recent i memòria personal per respondre't de manera més útil.\n\nLa memòria de Nova pot guardar detalls com ara com prefereixes que et diguin, interessos, estil de conversa o informació que comparteixes voluntàriament. Pots editar o esborrar aquesta memòria des de l'app.\n\nNova funciona mitjançant proveïdors tècnics d'IA, com Firebase Vertex AI/Gemini, i algunes tasques de moderació poden utilitzar serveis externs. No fem servir les teves converses amb Nova per vendre dades ni per a publicitat personalitzada de tercers.";
"privacyPolicy.section.visibility.title" = "5. Contingut, audiències i visibilitat";
"privacyPolicy.section.visibility.body" = "Tu controles qui pot veure part del teu contingut mitjançant compte privat, audiències, millors amics, llistes personalitzades, només jo, bloquejos, silencis i ajustos de visibilitat de seguidors, seguits i admiradors.\n\nEl contingut privat o restringit usa Blackout: Moments intenta ocultar-lo en captures i gravacions de pantalla mitjançant protecció segura del sistema. Les publicacions fetes per a everyone no fan servir aquesta protecció. Tot i això, cap mesura pot impedir del tot que algú copiï o comparteixi fora de l'app contingut al qual hagi tingut accés.";
"privacyPolicy.section.messages.title" = "6. Missatges i comunicacions";
"privacyPolicy.section.messages.body" = "Processem converses, sol·licituds de missatges, participants, marques de temps, confirmacions de lectura, fitxers multimèdia, missatges efímers i contingut compartit per entregar la missatgeria.\n\nApliquem xifratge i mesures de seguretat per protegir missatges i dades sensibles. Tot i això, algunes metadades, URLs de fitxers multimèdia o informació necessària per entregar el servei poden emmagatzemar-se i processar-se per separat.";
"privacyPolicy.section.permissions.title" = "7. Permisos del dispositiu";
"privacyPolicy.section.permissions.body" = "Demanem permisos només quan són necessaris per a una funció concreta: càmera per crear fotos o vídeos, galeria per pujar o desar contingut, micròfon per a àudio, i ubicació per etiquetar publicacions, mapes, contingut proper i context opcional de Nova.\n\nPots canviar aquests permisos des dels ajustos d'iOS. Si els desactives, algunes funcions poden deixar d'estar disponibles.";
"privacyPolicy.section.ads.title" = "8. Publicitat i consentiment";
"privacyPolicy.section.ads.body" = "Moments pot mostrar anuncis mitjançant Google AdMob. Segons la teva regió i ajustos, podem demanar consentiment mitjançant el formulari de privacitat de Google i el permís de rastreig d'Apple.\n\nSi acceptes, els anuncis poden ser personalitzats utilitzant identificadors publicitaris i senyals permesos. Si no acceptes, podem mostrar anuncis no personalitzats o limitats. També fem servir SKAdNetwork i tecnologies similars per a mesurament agregat.";
"privacyPolicy.section.moderation.title" = "9. Seguretat, denúncies i moderació";
"privacyPolicy.section.moderation.body" = "Fem servir denúncies d'usuaris, revisió automàtica i registres de seguretat per detectar spam, abusos, contingut il·legal, nuesa no permesa, violència, assetjament, suplantació, frau i altres usos que incompleixin les nostres normes.\n\nEls comentaris, imatges, vídeos o àudio poden ser analitzats per sistemes automàtics i proveïdors especialitzats. Podem ocultar contingut, limitar comptes, suspendre'ls o conservar registres necessaris per revisar apel·lacions i protegir la comunitat.";
"privacyPolicy.section.providers.title" = "10. Proveïdors i transferències";
"privacyPolicy.section.providers.body" = "Treballem amb proveïdors com Firebase/Google Cloud, Firebase Authentication, Firebase Storage, Firebase Vertex AI/Gemini, Google AdMob, Apple i proveïdors de moderació o infraestructura necessaris per operar Moments.\n\nAquests proveïdors poden processar dades en països diferents del teu. Quan cal, fem servir mesures contractuals i tècniques per protegir aquestes transferències.";
"privacyPolicy.section.retention.title" = "11. Conservació";
"privacyPolicy.section.retention.body" = "Conservem les dades mentre el teu compte estigui actiu o mentre siguin necessàries per prestar el servei. El contingut que esborres deixa de mostrar-se, tot i que pot romandre durant un temps limitat en còpies de seguretat, memòries cau, registres o sistemes de seguretat.\n\nLes històries, missatges efímers i contingut temporal segueixen les seves regles d'expiració. Les denúncies, apel·lacions, registres de seguretat i dades necessàries per complir obligacions legals poden conservar-se durant més temps.";
"privacyPolicy.section.rights.title" = "12. Els teus drets";
"privacyPolicy.section.rights.body" = "Pots sol·licitar accés, rectificació, eliminació, oposició, limitació, portabilitat de les teves dades i retirada del consentiment quan correspongui. També pots exportar dades, esborrar records de Nova, canviar la privacitat, bloquejar usuaris, silenciar comptes o paraules, desactivar el compte o sol·licitar-ne l'eliminació.\n\nSi ets a la Unió Europea o en una altra regió amb drets equivalents, també pots reclamar davant la teva autoritat de protecció de dades.";
"privacyPolicy.section.minors.title" = "13. Menors";
"privacyPolicy.section.minors.body" = "Moments no està dirigida a menors de 13 anys. Si detectem que un compte pertany a una persona per sota de l'edat mínima aplicable, podem limitar-lo o eliminar-lo. Si ets menor d'edat, fes servir Moments amb supervisió dels pares o tutors quan correspongui.";
"privacyPolicy.section.contact.title" = "14. Contacte i canvis";
"privacyPolicy.section.contact.body" = "Podem actualitzar aquesta política quan canviïn les nostres funcions, proveïdors o requisits legals. Si el canvi és important, ho comunicarem a l'app o per altres mitjans raonables.\n\nPer a preguntes o sol·licituds de privacitat, contacta amb nosaltres a soporte@moments.app o visita moments.app/privacy.";
