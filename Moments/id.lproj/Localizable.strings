/* Privacy Policy */
"privacyPolicy.title" = "Kebijakan Privasi";
"privacyPolicy.lastUpdated" = "Terakhir diperbarui: 30 Agustus 2026";
"privacyPolicy.section.summary.title" = "1. Ringkasan";
"privacyPolicy.section.summary.body" = "Moments adalah aplikasi sosial untuk berbagi momen, cerita, rantai, pesan, dan percakapan dengan Nova. Kami tidak mengumpulkan data yang tidak diperlukan atau membuat profil komersial tentang Anda.\n\nKami menyimpan atau memproses informasi minimum yang Anda masukkan, buat, atau izinkan saat menggunakan aplikasi, bersama data teknis yang diperlukan agar Moments dapat berfungsi, tetap aman, menyinkronkan konten, menampilkan iklan jika berlaku, dan menjalankan Nova.";
"privacyPolicy.section.data.title" = "2. Informasi yang Anda gunakan atau hasilkan di Moments";
"privacyPolicy.section.data.body" = "Saat membuat akun atau menyiapkan profil, kami menyimpan data seperti alamat email, nama pengguna, foto profil, bio, situs web, minat, lencana, status online, dan preferensi.\n\nSaat menggunakan aplikasi, kami menyimpan konten dan aktivitas yang Anda pilih untuk dibuat: momen, cerita, rantai, Echo, komentar, reaksi, item tersimpan, kunjungan, tag, daftar khusus, teman dekat, dan pengaturan audiens.\n\nKami juga memproses data teknis minimum yang diperlukan untuk keamanan, sesi, sinkronisasi, notifikasi, iklan, dan penyelesaian error.\n\nUntuk keamanan akun, kami juga dapat menyimpan alamat IP, informasi perangkat, token notifikasi push, sesi aktif, dan perkiraan lokasi Anda saat masuk atau mengaktifkan fitur keamanan.";
"privacyPolicy.section.use.title" = "3. Cara kami menggunakan data";
"privacyPolicy.section.use.body" = "Kami menggunakan informasi untuk menyediakan layanan, mengautentikasi Anda, menyinkronkan konten, mengirim pesan, menerapkan pengaturan privasi Anda, menyesuaikan pengalaman, meningkatkan Moments, mencegah penyalahgunaan, menangani laporan, dan memenuhi kewajiban hukum.\n\nDasar hukum yang digunakan dapat mencakup penyediaan layanan yang Anda minta, persetujuan Anda, kepentingan sah kami dalam menjaga keamanan dan meningkatkan produk, serta pemenuhan kewajiban hukum.";
"privacyPolicy.section.nova.title" = "4. Nova dan kecerdasan buatan";
"privacyPolicy.section.nova.body" = "Nova dapat memproses pesan, gambar yang Anda kirim, konteks akun, preferensi, aktivitas terbaru, dan memori pribadi Anda untuk memberikan respons yang lebih bermanfaat.\n\nMemori Nova dapat menyimpan detail seperti panggilan yang Anda sukai, minat, gaya percakapan, atau informasi yang Anda bagikan secara sukarela. Anda dapat mengedit atau menghapus memori ini dari aplikasi.\n\nNova juga dapat menggunakan penelusuran web untuk menjawab pertanyaan tertentu jika hal itu membantu memberikan respons yang bermanfaat.\n\nNova berfungsi melalui penyedia AI teknis, seperti Firebase Vertex AI/Gemini, dan beberapa tugas moderasi mungkin menggunakan layanan eksternal. Kami tidak menggunakan percakapan Anda dengan Nova untuk menjual data atau menayangkan iklan yang dipersonalisasi dari pihak ketiga.";
"privacyPolicy.section.visibility.title" = "5. Konten, audiens, dan visibilitas";
"privacyPolicy.section.visibility.body" = "Anda dapat mengatur siapa yang bisa melihat bagian tertentu dari konten Anda melalui pengaturan akun privat, audiens, teman dekat, daftar khusus, hanya saya, blokir, bisukan, serta pengaturan visibilitas untuk pengikut, akun yang Anda ikuti, dan pengagum.\n\nKonten privat atau terbatas menggunakan Blackout: Moments berupaya menyembunyikannya dari tangkapan layar dan rekaman layar dengan perlindungan sistem yang aman. Postingan yang dipublikasikan untuk semua orang tidak menggunakan perlindungan ini. Meski begitu, tidak ada cara yang sepenuhnya dapat mencegah orang menyalin atau membagikan di luar aplikasi konten yang dapat mereka akses.";
"privacyPolicy.section.messages.title" = "6. Pesan dan komunikasi";
"privacyPolicy.section.messages.body" = "Kami memproses percakapan, permintaan pesan, peserta, waktu, tanda sudah dibaca, file media, pesan sementara, dan konten yang dibagikan untuk menyediakan layanan pesan.\n\nKami menerapkan enkripsi dan langkah-langkah keamanan untuk melindungi pesan serta data sensitif. Namun, beberapa metadata, URL file media, atau informasi yang diperlukan untuk menyediakan layanan dapat disimpan dan diproses secara terpisah.\n\nJika Anda memilih untuk membagikan lokasi secara langsung dalam percakapan, kami memproses lokasi tersebut sampai sesi berbagi berakhir atau kedaluwarsa.";
"privacyPolicy.section.permissions.title" = "7. Izin perangkat";
"privacyPolicy.section.permissions.body" = "Kami hanya meminta izin saat diperlukan untuk fitur tertentu: kamera untuk membuat foto atau video, perpustakaan foto untuk mengunggah atau menyimpan konten, mikrofon untuk audio, dan lokasi untuk menambahkan tag pada postingan, menampilkan peta, konten di sekitar, serta konteks Nova opsional.\n\nAnda dapat mengubah izin ini di Pengaturan iOS. Jika izin dinonaktifkan, beberapa fitur mungkin tidak tersedia.";
"privacyPolicy.section.ads.title" = "8. Iklan dan persetujuan";
"privacyPolicy.section.ads.body" = "Moments dapat menampilkan iklan melalui Google AdMob. Bergantung pada wilayah dan pengaturan Anda, kami mungkin meminta persetujuan melalui formulir privasi Google dan izin pelacakan Apple.\n\nJika Anda menyetujuinya, iklan dapat dipersonalisasi menggunakan pengenal iklan dan sinyal yang diizinkan. Jika Anda tidak menyetujuinya, kami dapat menampilkan iklan yang tidak dipersonalisasi atau terbatas. Kami juga menggunakan SKAdNetwork dan teknologi serupa untuk pengukuran gabungan.";
"privacyPolicy.section.moderation.title" = "9. Keamanan, laporan, dan moderasi";
"privacyPolicy.section.moderation.body" = "Kami menggunakan laporan pengguna, peninjauan otomatis, dan log keamanan untuk mendeteksi spam, penyalahgunaan, konten ilegal, ketelanjangan yang dilarang, kekerasan, pelecehan, peniruan identitas, penipuan, dan penggunaan lain yang melanggar aturan kami.\n\nKomentar, gambar, video, atau audio dapat dianalisis oleh sistem otomatis dan penyedia khusus. Kami dapat menyembunyikan konten, membatasi akun, menangguhkan akun, atau menyimpan catatan yang diperlukan untuk meninjau banding dan melindungi komunitas.";
"privacyPolicy.section.providers.title" = "10. Penyedia dan transfer data";
"privacyPolicy.section.providers.body" = "Kami bekerja sama dengan penyedia seperti Firebase/Google Cloud, Firebase Authentication, Firebase Storage, Firebase Vertex AI/Gemini, Google AdMob, Apple, serta penyedia moderasi atau infrastruktur yang diperlukan untuk menjalankan Moments.\n\nPenyedia ini dapat memproses data di negara selain negara Anda. Jika diperlukan, kami menggunakan perlindungan kontraktual dan teknis untuk melindungi transfer tersebut.";
"privacyPolicy.section.retention.title" = "11. Penyimpanan data";
"privacyPolicy.section.retention.body" = "Kami menyimpan data selama akun Anda aktif atau selama data tersebut diperlukan untuk menyediakan layanan. Konten yang Anda hapus tidak lagi ditampilkan, tetapi mungkin masih tersimpan untuk waktu terbatas dalam cadangan, cache, log, atau sistem keamanan.\n\nStory, pesan sementara, dan konten temporer mengikuti aturan kedaluwarsanya masing-masing. Laporan, banding, log keamanan, dan data yang diperlukan untuk memenuhi kewajiban hukum dapat disimpan lebih lama.";
"privacyPolicy.section.rights.title" = "12. Hak Anda";
"privacyPolicy.section.rights.body" = "Anda dapat meminta akses, perbaikan, penghapusan, keberatan, pembatasan, dan portabilitas data, serta menarik persetujuan jika berlaku. Anda juga dapat mengekspor data, menghapus memori Nova, mengubah pengaturan privasi, memblokir pengguna, membisukan akun atau kata, menonaktifkan akun, atau meminta penghapusan akun.\n\nJika Anda berada di Uni Eropa atau wilayah lain dengan hak yang setara, Anda juga dapat mengajukan keluhan kepada otoritas perlindungan data.";
"privacyPolicy.section.minors.title" = "13. Anak di bawah umur";
"privacyPolicy.section.minors.body" = "Moments tidak ditujukan untuk anak-anak. Kamu harus memenuhi usia minimum yang ditampilkan saat pendaftaran untuk wilayahmu untuk membuat akun dan menggunakan layanan. Jika diwajibkan oleh hukum setempat, verifikasi usia tambahan atau persetujuan orang tua/wali mungkin diperlukan. Jika kami mendeteksi bahwa sebuah akun tidak memenuhi usia minimum yang berlaku atau persyaratan persetujuan, kami dapat membatasi atau menghapus akun tersebut.";
"privacyPolicy.section.contact.title" = "14. Kontak dan perubahan";
"privacyPolicy.section.contact.body" = "Kami dapat memperbarui kebijakan ini ketika fitur, penyedia, atau persyaratan hukum kami berubah. Jika perubahannya penting, kami akan menyampaikannya melalui aplikasi atau cara lain yang wajar.\n\nUntuk pertanyaan atau permintaan terkait privasi, hubungi kami di soporte@momentsapp.app atau kunjungi momentsapp.app/privacy.";
