/* Echo Info Sheet */
"echo.info.title" = "Apa itu Echo";
"echo.info.what.title" = "Apa itu Echo";
"echo.info.what.body" = "Echo adalah pengalaman bersama yang dibuat dari momen dengan tag lokasi. Echo menggabungkan berbagai sudut pandang dari momen yang sama menjadi satu rangkaian visual, dan hanya terbuka setelah minimal 2 peserta menerimanya.";
"echo.info.how.title" = "Cara kerjanya";
"echo.info.how.body" = "Echo mendeteksi momen dari teman yang saling mengikuti di area yang sama (hingga 500 m) dan dalam rentang waktu yang sama (24 jam). Setelah aktif, kamu dapat berpindah sudut pandang lewat bilah bawah, serta berpindah momen dengan mengusap ke atas atau bawah.";
"echo.info.privacy.title" = "Privasi";
"echo.info.privacy.body" = "Echo dibuat di antara teman yang saling mengikuti, tetapi tetap mencatat siapa saja yang dapat melihatnya saat itu. Jika hubungan kalian berubah setelahnya, Echo tetap terlihat; Echo hanya akan diburamkan jika audiens momen tersebut (Teman dekat atau daftar khusus) tidak menyertakanmu. Di dalam Echo, kamu dapat melihat momenmu dan momen dari peserta yang menerimanya.";
"echo.info.status.title" = "Status";
"echo.info.status.body" = "Aktif berarti Echo masih terbuka dan orang lain masih dapat bergabung selama 24 jam. Kedaluwarsa berarti rentang waktu tersebut telah berakhir dan Echo ditutup, sehingga tidak ada orang lain yang dapat bergabung.";
"echo.info.controls.title" = "Kontrol";
"echo.info.controls.body" = "Usap ke atas atau bawah untuk mengganti momen, gunakan bilah bawah untuk berpindah sudut pandang, dan gunakan menu untuk keluar dari Echo. Kamu tidak dapat keluar saat Echo masih aktif. Opsi keluar akan tersedia setelah rentang waktu 24 jam berakhir. Jika kamu keluar, momenmu akan dihapus dari Echo tersebut.";
