/* Privacy Policy */
"privacyPolicy.title" = "प्राइवेसी पॉलिसी";
"privacyPolicy.lastUpdated" = "आखिरी अपडेट: 30 अगस्त 2026";
"privacyPolicy.section.summary.title" = "1. सारांश";
"privacyPolicy.section.summary.body" = "Moments एक सोशल ऐप है, जहां आप Nova के साथ मोमेंट्स, स्टोरीज़, चेन्स, मैसेज और बातचीत शेयर कर सकते हैं। हम गैर-ज़रूरी डेटा इकट्ठा नहीं करते और न ही आपके बारे में व्यावसायिक प्रोफ़ाइल बनाते हैं।\n\nहम आपके द्वारा ऐप इस्तेमाल करते समय दर्ज, बनाए या चालू की गई ज़रूरी न्यूनतम जानकारी ही स्टोर या प्रोसेस करते हैं। इसके साथ Moments को चलाने, सुरक्षित रखने, कंटेंट सिंक करने, जहां लागू हो वहां विज्ञापन दिखाने और Nova को बेहतर बनाने के लिए ज़रूरी तकनीकी डेटा भी प्रोसेस किया जाता है।";
"privacyPolicy.section.data.title" = "2. Moments में आपके द्वारा इस्तेमाल या बनाया गया डेटा";
"privacyPolicy.section.data.body" = "जब आप अकाउंट बनाते हैं या अपनी प्रोफ़ाइल सेट अप करते हैं, तो हम ईमेल पता, यूज़रनेम, प्रोफ़ाइल फ़ोटो, बायो, वेबसाइट, रुचियां, बैज, ऑनलाइन स्थिति और पसंद जैसी जानकारी स्टोर करते हैं।\n\nऐप इस्तेमाल करते समय, हम आपके द्वारा बनाए गए मोमेंट्स, स्टोरीज़, चेन्स, echoes, कमेंट्स, रिएक्शन, सेव की गई चीज़ें, विज़िट, टैग, कस्टम लिस्ट, बेस्ट फ्रेंड्स और ऑडियंस सेटिंग जैसी सामग्री और गतिविधियां स्टोर करते हैं।\n\nहम सुरक्षा, सेशन, सिंकिंग, नोटिफ़िकेशन, विज्ञापनों और गड़बड़ियों को ठीक करने के लिए ज़रूरी न्यूनतम तकनीकी डेटा भी प्रोसेस करते हैं।\n\nअकाउंट की सुरक्षा के लिए, साइन इन करने या सुरक्षा सुविधाएं चालू करने पर हम आपका IP पता, डिवाइस की जानकारी, पुश नोटिफ़िकेशन टोकन, सक्रिय सेशन और अनुमानित लोकेशन भी स्टोर कर सकते हैं।";
"privacyPolicy.section.use.title" = "3. हम डेटा का इस्तेमाल कैसे करते हैं";
"privacyPolicy.section.use.body" = "हम जानकारी का इस्तेमाल सेवा उपलब्ध कराने, आपकी पहचान सत्यापित करने, कंटेंट सिंक करने, मैसेज पहुंचाने, आपकी प्राइवेसी सेटिंग लागू करने, अनुभव को आपकी पसंद के अनुसार बनाने, Moments को बेहतर करने, गलत इस्तेमाल रोकने, रिपोर्ट संभालने और कानूनी ज़िम्मेदारियां पूरी करने के लिए करते हैं।\n\nकानूनी आधारों में आपके अनुरोध पर सेवा उपलब्ध कराना, आपकी सहमति, सुरक्षा और प्रोडक्ट को बेहतर बनाने में हमारा वैध हित और कानूनी ज़िम्मेदारियां पूरी करना शामिल हो सकता है।";
"privacyPolicy.section.nova.title" = "4. Nova और आर्टिफ़िशियल इंटेलिजेंस";
"privacyPolicy.section.nova.body" = "Nova आपके संदेशों, भेजी गई तस्वीरों, अकाउंट से जुड़ी जानकारी, आपकी पसंद, हाल की गतिविधि और निजी मेमोरी को प्रोसेस कर सकता है, ताकि आपको ज़्यादा उपयोगी जवाब दे सके।\n\nNova की मेमोरी में यह जानकारी सेव हो सकती है कि आप किस नाम से बुलाया जाना पसंद करते हैं, आपकी रुचियां, बातचीत का तरीका या आपके द्वारा साझा की गई अन्य जानकारी। आप ऐप से इस मेमोरी को एडिट या डिलीट कर सकते हैं।\n\nबेहतर जवाब देने में मदद मिलने पर Nova कुछ सवालों के जवाब देने के लिए वेब सर्च का भी इस्तेमाल कर सकता है।\n\nNova तकनीकी AI प्रोवाइडर्स, जैसे Firebase Vertex AI/Gemini, के ज़रिए काम करता है और कुछ मॉडरेशन कार्यों के लिए बाहरी सेवाओं का इस्तेमाल किया जा सकता है। हम आपकी Nova बातचीत का इस्तेमाल डेटा बेचने या थर्ड-पार्टी पर्सनलाइज़्ड विज्ञापन के लिए नहीं करते।";
"privacyPolicy.section.visibility.title" = "5. कंटेंट, ऑडियंस और विज़िबिलिटी";
"privacyPolicy.section.visibility.body" = "आप तय करते हैं कि आपके कंटेंट के कुछ हिस्से कौन देख सकता है। इसके लिए प्राइवेट अकाउंट सेटिंग्स, ऑडियंस, बेस्ट फ्रेंड्स, कस्टम लिस्ट, सिर्फ़ मैं, ब्लॉक, म्यूट और फ़ॉलोअर्स, फ़ॉलोइंग व प्रशंसकों के लिए विज़िबिलिटी सेटिंग्स उपलब्ध हैं।\n\nप्राइवेट या सीमित कंटेंट के लिए Blackout का इस्तेमाल होता है। Moments सुरक्षित सिस्टम प्रोटेक्शन की मदद से इसे स्क्रीनशॉट और स्क्रीन रिकॉर्डिंग से छिपाने की कोशिश करता है। सभी के लिए प्रकाशित पोस्ट पर यह सुरक्षा लागू नहीं होती। फिर भी, कोई भी उपाय किसी व्यक्ति को ऐप के बाहर उस कंटेंट को कॉपी या शेयर करने से पूरी तरह नहीं रोक सकता, जिसे वह देख सका हो।";
"privacyPolicy.section.messages.title" = "6. संदेश और बातचीत";
"privacyPolicy.section.messages.body" = "मैसेजिंग सेवा देने के लिए हम बातचीत, मैसेज रिक्वेस्ट, प्रतिभागियों, टाइमस्टैम्प, पढ़े जाने की रसीदों, मीडिया फ़ाइलों, कुछ समय बाद गायब होने वाले संदेशों और शेयर किए गए कंटेंट को प्रोसेस करते हैं।\n\nसंदेशों और संवेदनशील डेटा की सुरक्षा के लिए हम एन्क्रिप्शन और सुरक्षा उपायों का इस्तेमाल करते हैं। हालांकि, कुछ मेटाडेटा, मीडिया फ़ाइल URL या सेवा देने के लिए ज़रूरी जानकारी अलग से सेव और प्रोसेस की जा सकती है।\n\nअगर आप बातचीत में लाइव लोकेशन शेयर करना चुनते हैं, तो शेयरिंग सेशन खत्म या एक्सपायर होने तक हम उस लोकेशन को प्रोसेस करते हैं।";
"privacyPolicy.section.permissions.title" = "7. डिवाइस की अनुमतियां";
"privacyPolicy.section.permissions.body" = "हम अनुमतियां तभी मांगते हैं, जब किसी खास फ़ीचर के लिए उनकी ज़रूरत हो: फ़ोटो या वीडियो बनाने के लिए कैमरा, कंटेंट अपलोड या सेव करने के लिए फ़ोटो लाइब्रेरी, ऑडियो के लिए माइक्रोफ़ोन और पोस्ट में टैग लगाने, मैप, आस-पास का कंटेंट और Nova का वैकल्पिक संदर्भ दिखाने के लिए लोकेशन।\n\nआप iOS Settings में इन अनुमतियों को बदल सकते हैं। अगर आप इन्हें बंद कर देते हैं, तो कुछ फ़ीचर उपलब्ध नहीं रह सकते।";
"privacyPolicy.section.ads.title" = "8. विज्ञापन और सहमति";
"privacyPolicy.section.ads.body" = "Moments Google AdMob के ज़रिए विज्ञापन दिखा सकता है। आपके क्षेत्र और सेटिंग्स के आधार पर, हम Google के प्राइवेसी फ़ॉर्म और Apple की ट्रैकिंग अनुमति के ज़रिए आपकी सहमति मांग सकते हैं।\n\nअगर आप सहमति देते हैं, तो विज्ञापन आइडेंटिफ़ायर और अनुमत सिग्नल का इस्तेमाल करके विज्ञापनों को आपके लिए पर्सनलाइज़ किया जा सकता है। अगर आप सहमति नहीं देते, तो हम गैर-पर्सनलाइज़्ड या सीमित विज्ञापन दिखा सकते हैं। हम समग्र माप के लिए SKAdNetwork और इसी तरह की तकनीकों का भी इस्तेमाल करते हैं।";
"privacyPolicy.section.moderation.title" = "9. सुरक्षा, रिपोर्ट और मॉडरेशन";
"privacyPolicy.section.moderation.body" = "स्पैम, दुर्व्यवहार, गैरकानूनी कंटेंट, प्रतिबंधित नग्नता, हिंसा, उत्पीड़न, किसी और की पहचान का गलत इस्तेमाल, धोखाधड़ी और हमारे नियमों का उल्लंघन करने वाली अन्य गतिविधियों का पता लगाने के लिए हम यूज़र रिपोर्ट, ऑटोमेटेड रिव्यू और सुरक्षा लॉग का इस्तेमाल करते हैं।\n\nकमेंट, तस्वीरों, वीडियो या ऑडियो का विश्लेषण ऑटोमेटेड सिस्टम और विशेषज्ञ प्रोवाइडर्स कर सकते हैं। हम कंटेंट छिपा सकते हैं, अकाउंट की सुविधाएं सीमित कर सकते हैं, अकाउंट सस्पेंड कर सकते हैं या अपील की समीक्षा और कम्युनिटी की सुरक्षा के लिए ज़रूरी रिकॉर्ड रख सकते हैं।";
"privacyPolicy.section.providers.title" = "10. प्रोवाइडर्स और डेटा ट्रांसफ़र";
"privacyPolicy.section.providers.body" = "Moments चलाने के लिए हम Firebase/Google Cloud, Firebase Authentication, Firebase Storage, Firebase Vertex AI/Gemini, Google AdMob, Apple और मॉडरेशन या इंफ़्रास्ट्रक्चर से जुड़े ज़रूरी प्रोवाइडर्स के साथ काम करते हैं।\n\nये प्रोवाइडर्स आपके देश के अलावा दूसरे देशों में डेटा प्रोसेस कर सकते हैं। जहां ज़रूरी हो, हम इन ट्रांसफ़र को सुरक्षित रखने के लिए कॉन्ट्रैक्चुअल और तकनीकी सुरक्षा उपायों का इस्तेमाल करते हैं।";
"privacyPolicy.section.retention.title" = "11. डेटा कितने समय तक रखा जाता है";
"privacyPolicy.section.retention.body" = "हम डेटा तब तक रखते हैं, जब तक आपका अकाउंट सक्रिय रहता है या सेवा देने के लिए इसकी ज़रूरत होती है। आपके डिलीट किए गए कंटेंट दिखना बंद हो जाते हैं, हालांकि वे कुछ समय तक बैकअप, कैश, लॉग या सुरक्षा सिस्टम में रह सकते हैं।\n\nस्टोरी, कुछ समय बाद गायब होने वाले संदेश और अस्थायी कंटेंट अपने एक्सपायर होने के नियमों के अनुसार हटते हैं। रिपोर्ट, अपील, सुरक्षा लॉग और कानूनी दायित्वों को पूरा करने के लिए ज़रूरी डेटा ज़्यादा समय तक रखा जा सकता है।";
"privacyPolicy.section.rights.title" = "12. आपके अधिकार";
"privacyPolicy.section.rights.body" = "जहां लागू हो, आप अपने डेटा को देखने, सही कराने, डिलीट कराने, उसके इस्तेमाल पर आपत्ति करने, इस्तेमाल सीमित कराने, पोर्ट करने और अपनी सहमति वापस लेने का अनुरोध कर सकते हैं। आप डेटा एक्सपोर्ट कर सकते हैं, Nova की मेमोरी डिलीट कर सकते हैं, प्राइवेसी सेटिंग्स बदल सकते हैं, यूज़र्स को ब्लॉक कर सकते हैं, अकाउंट या शब्दों को म्यूट कर सकते हैं, अपना अकाउंट डीऐक्टिवेट कर सकते हैं या उसे डिलीट करने का अनुरोध कर सकते हैं।\n\nअगर आप यूरोपीय संघ या समान अधिकारों वाले किसी अन्य क्षेत्र में हैं, तो आप अपने डेटा सुरक्षा प्राधिकरण से शिकायत भी कर सकते हैं।";
"privacyPolicy.section.minors.title" = "13. नाबालिग";
"privacyPolicy.section.minors.body" = "Moments बच्चों के लिए नहीं है। अकाउंट बनाने और सेवा इस्तेमाल करने के लिए आपको अपने क्षेत्र के लिए पंजीकरण के दौरान दिखाई जाने वाली न्यूनतम आयु पूरी करनी होगी। स्थानीय कानून के अनुसार, अतिरिक्त आयु सत्यापन या माता-पिता/अभिभावक की सहमति आवश्यक हो सकती है। यदि कोई अकाउंट लागू न्यूनतम उम्र या सहमति की शर्तें पूरी नहीं करता, तो हम उसे सीमित या हटा सकते हैं।";
"privacyPolicy.section.contact.title" = "14. संपर्क और बदलाव";
"privacyPolicy.section.contact.body" = "हम इस पॉलिसी को तब अपडेट कर सकते हैं, जब हमारे फ़ीचर, प्रोवाइडर्स या कानूनी ज़रूरतों में बदलाव हो। अगर कोई बदलाव महत्वपूर्ण होगा, तो हम आपको ऐप में या किसी अन्य उचित माध्यम से बताएंगे।\n\nप्राइवेसी से जुड़े सवालों या अनुरोधों के लिए soporte@momentsapp.app पर संपर्क करें या momentsapp.app/privacy पर जाएं।";
