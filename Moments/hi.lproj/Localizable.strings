/* Echo Info Sheet */
"echo.info.title" = "Echo क्या है";
"echo.info.what.title" = "यह क्या है";
"echo.info.what.body" = "Echo किसी लोकेशन वाले मोमेंट से जुड़ा साझा अनुभव है। इसमें उसी पल के कई नज़रियों को एक विज़ुअल थ्रेड में जोड़ा जाता है। यह कम-से-कम 2 प्रतिभागियों के स्वीकार करने के बाद ही खुलता है।";
"echo.info.how.title" = "यह कैसे काम करता है";
"echo.info.how.body" = "Echo एक ही इलाके (500 मीटर तक) और समय-सीमा (24 घंटे) में आपके म्यूचुअल्स के मोमेंट का पता लगाता है। सक्रिय होने के बाद, आप नीचे की बार से अलग-अलग नज़रियों और ऊपर/नीचे स्वाइप करके मोमेंट्स के बीच जा सकते हैं।";
"echo.info.privacy.title" = "प्राइवेसी";
"echo.info.privacy.body" = "Echo म्यूचुअल्स के बीच बनता है, लेकिन उस समय इसे कौन देख सकता था, यह जानकारी सुरक्षित रखता है। बाद में आपका रिश्ता बदल जाए, तब भी यह दिखाई देता रहेगा। यह सिर्फ़ तब धुंधला होगा, जब मोमेंट की ऑडियंस (बेस्ट फ़्रेंड्स या कस्टम लिस्ट) में आप शामिल न हों। Echo के अंदर आपको अपने मोमेंट्स और स्वीकार करने वाले प्रतिभागियों के मोमेंट्स दिखेंगे।";
"echo.info.status.title" = "स्टेटस";
"echo.info.status.body" = "सक्रिय का मतलब है कि Echo अभी खुला है और 24 घंटे की अवधि के दौरान दूसरे लोग इसमें शामिल हो सकते हैं। समाप्त का मतलब है कि यह अवधि खत्म हो गई है और Echo बंद हो गया है, इसलिए अब कोई और इसमें शामिल नहीं हो सकता।";
"echo.info.controls.title" = "कंट्रोल";
"echo.info.controls.body" = "मोमेंट बदलने के लिए ऊपर/नीचे स्वाइप करें, नज़रिया बदलने के लिए नीचे की बार का इस्तेमाल करें और Echo छोड़ने के लिए मेन्यू खोलें। Echo के सक्रिय रहने तक आप इसे छोड़ नहीं सकते। इसकी 24 घंटे की अवधि खत्म होने पर छोड़ने का विकल्प खुल जाएगा। अगर आप छोड़ते हैं, तो आपके मोमेंट्स उस Echo से हटा दिए जाएंगे।";
