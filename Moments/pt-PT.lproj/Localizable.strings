"echo.info.status.title" = "Estados";
"echo.info.status.body" = "Ativo significa que o Echo ainda está aberto e outras pessoas ainda podem entrar durante a tua janela de 24 horas. Expirado significa que essa janela acabou e o Echo fecha, por isso ninguém mais consegue entrar.";
