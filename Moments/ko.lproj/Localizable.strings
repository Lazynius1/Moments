/* Privacy Policy */
"privacyPolicy.title" = "개인정보처리방침";
"privacyPolicy.lastUpdated" = "최종 업데이트: 2026년 8월 30일";
"privacyPolicy.section.summary.title" = "1. 요약";
"privacyPolicy.section.summary.body" = "Moments는 Nova와 함께 순간, 스토리, 체인, 메시지, 대화를 공유하는 소셜 앱이에요. 불필요한 데이터를 수집하거나 회원님의 상업적 프로필을 만들지 않아요.\n\n앱을 사용하는 동안 회원님이 입력하거나 만들거나 사용 설정한 정보 중 최소한의 정보만 저장하거나 처리해요. 또한 Moments의 작동과 보안 유지, 콘텐츠 동기화, 해당하는 경우 광고 표시, Nova 운영에 필요한 기술 데이터도 처리해요.";
"privacyPolicy.section.data.title" = "2. Moments에서 사용하거나 생성하는 정보";
"privacyPolicy.section.data.body" = "계정을 만들거나 프로필을 설정하면 이메일 주소, 사용자 이름, 프로필 사진, 자기소개, 웹사이트, 관심사, 배지, 온라인 상태, 환경설정 등의 데이터를 저장해요.\n\n앱을 사용하면 회원님이 직접 만들기로 선택한 콘텐츠와 활동을 저장해요. 여기에는 moments, 스토리, 체인, Echo, 댓글, 반응, 저장한 항목, 방문 기록, 태그, 맞춤 목록, 친한 친구, 공개 대상 설정 등이 포함돼요.\n\n또한 보안, 세션, 동기화, 알림, 광고, 오류 해결에 필요한 최소한의 기술 데이터도 처리해요.\n\n계정 보안을 위해 로그인하거나 보안 기능을 사용 설정하면 IP 주소, 기기 정보, 푸시 알림 토큰, 활성 세션, 대략적인 위치 정보도 저장할 수 있어요.";
"privacyPolicy.section.use.title" = "3. 데이터 이용 방법";
"privacyPolicy.section.use.body" = "서비스 제공, 회원님 인증, 콘텐츠 동기화, 메시지 전송, 개인정보 설정 적용, 맞춤형 이용 환경 제공, Moments 개선, 악용 방지, 신고 처리, 법적 의무 준수를 위해 정보를 사용해요.\n\n법적 근거에는 회원님이 요청한 서비스 제공, 회원님의 동의, 보안 및 제품 개선을 위한 정당한 이익, 법적 의무 준수 등이 포함될 수 있어요.";
"privacyPolicy.section.nova.title" = "4. Nova 및 인공지능";
"privacyPolicy.section.nova.body" = "Nova는 더 유용한 답변을 제공하기 위해 회원님의 메시지, Nova에 보내는 이미지, 계정 정보, 환경설정, 최근 활동 및 개인 메모리를 처리할 수 있어요.\n\nNova의 메모리에는 선호하는 호칭, 관심사, 대화 스타일 또는 회원님이 자발적으로 공유한 정보가 저장될 수 있어요. 이 메모리는 앱에서 수정하거나 삭제할 수 있어요.\n\n또한 Nova는 유용한 답변을 제공하는 데 도움이 되는 경우 일부 질문에 답하기 위해 웹 검색을 사용할 수 있어요.\n\nNova는 Firebase Vertex AI/Gemini와 같은 기술 AI 제공업체를 통해 작동하며, 일부 검토 작업에는 외부 서비스가 사용될 수 있어요. 회원님의 Nova 대화는 데이터를 판매하거나 제3자 맞춤형 광고를 제공하는 데 사용하지 않아요.";
"privacyPolicy.section.visibility.title" = "5. 콘텐츠, 대상 및 공개 범위";
"privacyPolicy.section.visibility.body" = "비공개 계정 설정, 대상 설정, 친한 친구, 맞춤 목록, 나만 보기, 차단 및 숨김 기능과 팔로워, 팔로잉, 팬을 위한 공개 범위 설정을 통해 콘텐츠의 일부를 누가 볼 수 있는지 직접 관리할 수 있어요.\n\n비공개 또는 제한된 콘텐츠에는 Blackout이 적용돼요. Moments는 시스템 보안 보호 기능을 사용해 해당 콘텐츠가 스크린샷이나 화면 녹화에 노출되지 않도록 최대한 보호해요. 모든 사람에게 공개된 게시물에는 이 보호 기능이 적용되지 않아요. 그래도 누군가 앱에서 볼 수 있었던 콘텐츠를 복사하거나 앱 외부로 공유하는 것을 완전히 막을 수 있는 방법은 없어요.";
"privacyPolicy.section.messages.title" = "6. 메시지 및 커뮤니케이션";
"privacyPolicy.section.messages.body" = "메시지 기능을 제공하기 위해 대화, 메시지 요청, 참여자, 타임스탬프, 읽음 확인, 미디어 파일, 사라지는 메시지 및 공유된 콘텐츠를 처리해요.\n\n메시지와 민감한 데이터를 보호하기 위해 암호화 및 보안 조치를 적용해요. 다만 일부 메타데이터, 미디어 파일 URL 또는 서비스 제공에 필요한 정보는 별도로 저장되고 처리될 수 있어요.\n\n대화에서 실시간 위치 공유를 선택하면 공유 세션이 종료되거나 만료될 때까지 해당 위치 정보를 처리해요.";
"privacyPolicy.section.permissions.title" = "7. 기기 권한";
"privacyPolicy.section.permissions.body" = "특정 기능에 필요한 경우에만 권한을 요청해요. 사진이나 동영상을 만들 때는 카메라, 콘텐츠를 업로드하거나 저장할 때는 사진 보관함, 오디오 기능에는 마이크, 게시물에 위치를 표시하거나 지도와 주변 콘텐츠 및 선택적 Nova 정보를 표시할 때는 위치 권한이 필요해요.\n\n이 권한은 iOS 설정에서 변경할 수 있어요. 권한을 끄면 일부 기능을 이용하지 못할 수 있어요.";
"privacyPolicy.section.ads.title" = "8. 광고 및 동의";
"privacyPolicy.section.ads.body" = "Moments는 Google AdMob을 통해 광고를 표시할 수 있어요. 지역과 설정에 따라 Google의 개인정보 보호 양식과 Apple의 추적 권한 요청을 통해 동의를 요청할 수 있어요.\n\n동의하면 광고 식별자와 허용된 신호를 사용해 광고가 맞춤형으로 표시될 수 있어요. 동의하지 않으면 맞춤 설정되지 않은 광고 또는 제한된 광고가 표시될 수 있어요. 또한 통합 측정을 위해 SKAdNetwork 및 유사한 기술을 사용해요.";
"privacyPolicy.section.moderation.title" = "9. 안전, 신고 및 검토";
"privacyPolicy.section.moderation.body" = "스팸, 악용, 불법 콘텐츠, 금지된 노출, 폭력, 괴롭힘, 사칭, 사기 및 운영 정책을 위반하는 기타 행위를 감지하기 위해 사용자 신고, 자동 검토 및 보안 로그를 사용해요.\n\n댓글, 이미지, 동영상 또는 오디오는 자동화된 시스템과 전문 제공업체를 통해 분석될 수 있어요. 커뮤니티를 보호하고 이의 제기를 검토하는 데 필요한 기록을 보관하면서 콘텐츠를 숨기거나 계정의 활동을 제한 또는 정지할 수 있어요.";
"privacyPolicy.section.providers.title" = "10. 제공업체 및 데이터 이전";
"privacyPolicy.section.providers.body" = "Moments 운영에 필요한 Firebase/Google Cloud, Firebase Authentication, Firebase Storage, Firebase Vertex AI/Gemini, Google AdMob, Apple 및 검토·인프라 제공업체와 협력해요.\n\n이러한 제공업체는 회원님의 국가가 아닌 다른 국가에서 데이터를 처리할 수 있어요. 필요한 경우 계약상 및 기술적 보호 조치를 사용해 데이터 이전을 보호해요.";
"privacyPolicy.section.retention.title" = "11. 보관 기간";
"privacyPolicy.section.retention.body" = "계정이 활성 상태이거나 서비스 제공에 필요한 동안 데이터를 보관해요. 삭제한 콘텐츠는 더 이상 표시되지 않지만 백업, 캐시, 로그 또는 보안 시스템에 제한된 기간 동안 남아 있을 수 있어요.\n\n스토리, 사라지는 메시지 및 임시 콘텐츠에는 각각의 만료 규칙이 적용돼요. 신고, 이의 제기, 보안 로그 및 법적 의무를 이행하는 데 필요한 데이터는 더 오래 보관될 수 있어요.";
"privacyPolicy.section.rights.title" = "12. 회원님의 권리";
"privacyPolicy.section.rights.body" = "해당되는 경우 데이터 열람, 수정, 삭제, 처리 거부, 처리 제한, 데이터 이동을 요청하고 동의를 철회할 수 있어요. 또한 데이터를 내보내고, Nova 메모리를 삭제하고, 개인정보 설정을 변경하고, 사용자를 차단하고, 계정이나 단어를 숨기고, 계정을 비활성화하거나 삭제를 요청할 수 있어요.\n\n유럽연합 또는 이와 동등한 권리를 보장하는 지역에 거주하는 경우, 데이터 보호 기관에 민원을 제기할 수도 있어요.";
"privacyPolicy.section.minors.title" = "13. 미성년자";
"privacyPolicy.section.minors.body" = "Moments는 아동을 대상으로 하지 않아요. 계정을 만들고 서비스를 이용하려면 가입할 때 거주 지역에 표시되는 최소 연령을 충족해야 해요. 현지 법률에서 요구하는 경우 추가 연령 확인이나 보호자 동의가 필요할 수 있어요. 계정이 해당 최소 연령 또는 동의 요건을 충족하지 않는 것으로 확인되면 계정 이용을 제한하거나 삭제할 수 있어요.";
"privacyPolicy.section.contact.title" = "14. 문의 및 변경 사항";
"privacyPolicy.section.contact.body" = "기능, 제공업체 또는 법적 요건이 변경되면 이 정책을 업데이트할 수 있어요. 중요한 변경 사항이 있는 경우 앱이나 기타 합리적인 방법을 통해 알려드릴게요.\n\n개인정보 보호에 관한 질문이나 요청은 soporte@momentsapp.app으로 문의하거나 momentsapp.app/privacy를 방문해 주세요.";
