/* Privacy Policy */
"privacyPolicy.title" = "Polityka prywatności";
"privacyPolicy.lastUpdated" = "Ostatnia aktualizacja: 30 sierpnia 2026 r.";
"privacyPolicy.section.summary.title" = "1. Podsumowanie";
"privacyPolicy.section.summary.body" = "Moments to aplikacja społecznościowa do dzielenia się momentami, relacjami, łańcuchami, wiadomościami i rozmowami z Nova. Nie zbieramy zbędnych danych ani nie tworzymy na Twój temat profili komercyjnych.\n\nPrzechowujemy lub przetwarzamy tylko niezbędne informacje, które podajesz, tworzysz lub udostępniasz podczas korzystania z aplikacji, a także dane techniczne potrzebne do działania i zabezpieczania Moments, synchronizowania treści, wyświetlania reklam, gdy ma to zastosowanie, oraz działania Nova.";
"privacyPolicy.section.data.title" = "2. Informacje używane lub tworzone w Moments";
"privacyPolicy.section.data.body" = "Gdy tworzysz konto lub konfigurujesz profil, przechowujemy takie dane jak adres e-mail, nazwa użytkownika, zdjęcie profilowe, biogram, strona internetowa, zainteresowania, odznaki, status online i ustawienia.\n\nPodczas korzystania z aplikacji przechowujemy treści i działania, które zdecydujesz się utworzyć: momenty, relacje, łańcuchy, echa, komentarze, reakcje, zapisane elementy, odwiedziny, oznaczenia, niestandardowe listy, listę najlepszych znajomych i ustawienia odbiorców.\n\nPrzetwarzamy również minimalny zakres danych technicznych potrzebnych do zapewnienia bezpieczeństwa, obsługi sesji, synchronizacji, wysyłania powiadomień, wyświetlania reklam i rozwiązywania problemów.\n\nW celu zabezpieczenia konta możemy również przechowywać Twój adres IP, informacje o urządzeniu, token powiadomień push, aktywne sesje i przybliżoną lokalizację, gdy się logujesz lub włączasz funkcje bezpieczeństwa.";
"privacyPolicy.section.use.title" = "3. Jak wykorzystujemy dane";
"privacyPolicy.section.use.body" = "Wykorzystujemy informacje, aby świadczyć usługę, uwierzytelniać użytkowników, synchronizować treści, dostarczać wiadomości, stosować ustawienia prywatności, personalizować korzystanie z aplikacji, ulepszać Moments, zapobiegać nadużyciom, obsługiwać zgłoszenia i wypełniać obowiązki prawne.\n\nPodstawą prawną może być świadczenie zamówionej przez Ciebie usługi, Twoja zgoda, nasz uzasadniony interes polegający na zapewnianiu bezpieczeństwa i ulepszaniu produktu oraz wypełnianie obowiązków prawnych.";
"privacyPolicy.section.nova.title" = "4. Nova i sztuczna inteligencja";
"privacyPolicy.section.nova.body" = "Nova może przetwarzać Twoje wiadomości, wysyłane przez Ciebie obrazy, informacje związane z kontem, preferencje, ostatnią aktywność oraz zapamiętane informacje, aby udzielać bardziej pomocnych odpowiedzi.\n\nPamięć Nova może przechowywać takie informacje jak preferowane imię, zainteresowania, styl rozmowy lub dane, które dobrowolnie udostępnisz. Możesz edytować lub usunąć te informacje w aplikacji.\n\nNova może również korzystać z wyszukiwarki internetowej, aby odpowiadać na niektóre pytania, gdy pomoże to udzielić przydatnej odpowiedzi.\n\nNova działa za pośrednictwem dostawców technologii AI, takich jak Firebase Vertex AI/Gemini, a niektóre zadania związane z moderacją mogą być realizowane przez zewnętrzne usługi. Nie wykorzystujemy rozmów z Nova do sprzedaży danych ani do personalizowanych reklam stron trzecich.";
"privacyPolicy.section.visibility.title" = "5. Treści, odbiorcy i widoczność";
"privacyPolicy.section.visibility.body" = "To Ty decydujesz, kto może widzieć poszczególne treści, korzystając z ustawień konta prywatnego, list odbiorców, listy bliskich znajomych, własnych list, opcji „Tylko ja”, blokowania i wyciszania oraz ustawień widoczności dla obserwujących, obserwowanych i fanów.\n\nTreści prywatne lub ograniczone korzystają z Blackout: Moments stara się ukryć je przed zrzutami ekranu i nagrywaniem ekranu za pomocą bezpiecznych zabezpieczeń systemowych. Posty udostępnione wszystkim nie korzystają z tej ochrony. Żadne zabezpieczenie nie może jednak całkowicie uniemożliwić skopiowania lub udostępnienia poza aplikacją treści, do których ktoś uzyskał dostęp.";
"privacyPolicy.section.messages.title" = "6. Wiadomości i komunikacja";
"privacyPolicy.section.messages.body" = "Przetwarzamy rozmowy, prośby o wiadomość, uczestników, znaczniki czasu, potwierdzenia odczytania, pliki multimedialne, wiadomości znikające i udostępniane treści, aby zapewnić działanie komunikatora.\n\nStosujemy szyfrowanie i środki bezpieczeństwa, aby chronić wiadomości oraz poufne dane. Niektóre metadane, adresy URL plików multimedialnych lub informacje potrzebne do świadczenia usługi mogą być jednak przechowywane i przetwarzane oddzielnie.\n\nJeśli zdecydujesz się udostępnić w rozmowie swoją lokalizację na żywo, będziemy ją przetwarzać do zakończenia lub wygaśnięcia sesji udostępniania.";
"privacyPolicy.section.permissions.title" = "7. Uprawnienia urządzenia";
"privacyPolicy.section.permissions.body" = "Prosimy o uprawnienia tylko wtedy, gdy są potrzebne do konkretnej funkcji: aparat do tworzenia zdjęć lub filmów, biblioteka zdjęć do przesyłania lub zapisywania treści, mikrofon do obsługi dźwięku oraz lokalizacja do oznaczania postów, wyświetlania map, treści w pobliżu i opcjonalnego kontekstu dla Nova.\n\nMożesz zmienić te uprawnienia w Ustawieniach iOS. Jeśli je wyłączysz, niektóre funkcje mogą przestać być dostępne.";
"privacyPolicy.section.ads.title" = "8. Reklamy i zgoda";
"privacyPolicy.section.ads.body" = "Moments może wyświetlać reklamy za pośrednictwem Google AdMob. W zależności od regionu i ustawień możemy poprosić Cię o zgodę za pomocą formularza Google dotyczącego prywatności oraz systemowego pytania Apple o zgodę na śledzenie.\n\nJeśli wyrazisz zgodę, reklamy mogą być personalizowane na podstawie identyfikatorów reklamowych i dozwolonych sygnałów. Jeśli nie wyrazisz zgody, możemy wyświetlać reklamy niespersonalizowane lub ograniczone. Korzystamy również z SKAdNetwork i podobnych technologii do pomiarów zbiorczych.";
"privacyPolicy.section.moderation.title" = "9. Bezpieczeństwo, zgłoszenia i moderacja";
"privacyPolicy.section.moderation.body" = "Korzystamy ze zgłoszeń użytkowników, automatycznej weryfikacji i dzienników bezpieczeństwa, aby wykrywać spam, nadużycia, nielegalne treści, niedozwoloną nagość, przemoc, nękanie, podszywanie się pod inne osoby, oszustwa oraz inne działania naruszające nasze zasady.\n\nKomentarze, obrazy, filmy i dźwięk mogą być analizowane przez systemy automatyczne oraz wyspecjalizowanych dostawców. Możemy ukrywać treści, ograniczać konta, zawieszać je lub przechowywać informacje potrzebne do rozpatrywania odwołań i ochrony społeczności.";
"privacyPolicy.section.providers.title" = "10. Dostawcy i przekazywanie danych";
"privacyPolicy.section.providers.body" = "Współpracujemy z dostawcami takimi jak Firebase/Google Cloud, Firebase Authentication, Firebase Storage, Firebase Vertex AI/Gemini, Google AdMob, Apple oraz dostawcami usług moderacyjnych i infrastrukturalnych potrzebnych do działania Moments.\n\nDostawcy ci mogą przetwarzać dane w krajach innych niż Twój. W razie potrzeby stosujemy umowne i techniczne zabezpieczenia, aby chronić takie przekazywanie danych.";
"privacyPolicy.section.retention.title" = "11. Przechowywanie danych";
"privacyPolicy.section.retention.body" = "Przechowujemy dane, dopóki Twoje konto jest aktywne lub dopóki są potrzebne do świadczenia usługi. Usunięte przez Ciebie treści przestają być wyświetlane, ale przez ograniczony czas mogą pozostać w kopiach zapasowych, pamięci podręcznej, dziennikach lub systemach bezpieczeństwa.\n\nRelacje, wiadomości znikające i treści tymczasowe podlegają własnym zasadom wygasania. Zgłoszenia, odwołania, dzienniki bezpieczeństwa oraz dane potrzebne do wypełnienia obowiązków prawnych mogą być przechowywane dłużej.";
"privacyPolicy.section.rights.title" = "12. Twoje prawa";
"privacyPolicy.section.rights.body" = "Możesz poprosić o dostęp do swoich danych, ich poprawienie, usunięcie, ograniczenie przetwarzania, przeniesienie lub wyrazić sprzeciw wobec przetwarzania, a także wycofać zgodę, jeśli ma to zastosowanie. Możesz również eksportować dane, usuwać zapamiętane informacje Nova, zmieniać ustawienia prywatności, blokować użytkowników, wyciszać konta lub słowa, dezaktywować konto albo poprosić o jego usunięcie.\n\nJeśli mieszkasz w Unii Europejskiej lub innym regionie, w którym obowiązują podobne prawa, możesz również złożyć skargę do organu ochrony danych.";
"privacyPolicy.section.minors.title" = "13. Osoby niepełnoletnie";
"privacyPolicy.section.minors.body" = "Moments nie jest przeznaczone dla dzieci. Musisz spełniać minimalny wiek wskazany podczas rejestracji dla Twojego regionu, aby utworzyć konto i korzystać z usługi. Gdy wymaga tego lokalne prawo, mogą obowiązywać dodatkowa weryfikacja wieku lub zgoda rodzica albo opiekuna. Jeśli wykryjemy, że konto nie spełnia obowiązującego minimalnego wieku lub wymogów dotyczących zgody, możemy je ograniczyć lub usunąć.";
"privacyPolicy.section.contact.title" = "14. Kontakt i zmiany";
"privacyPolicy.section.contact.body" = "Możemy aktualizować tę politykę, gdy zmienią się nasze funkcje, dostawcy lub wymagania prawne. Jeśli zmiana będzie istotna, poinformujemy Cię w aplikacji lub w inny uzasadniony sposób.\n\nW sprawach dotyczących prywatności lub próśb związanych z danymi napisz na adres soporte@momentsapp.app lub odwiedź momentsapp.app/privacy.";
