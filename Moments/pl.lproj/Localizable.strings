/* Echo Info Sheet */
"echo.info.title" = "Czym jest Echo";
"echo.info.what.title" = "Co to jest";
"echo.info.what.body" = "Echo to wspólne doświadczenie związane z momentem oznaczonym lokalizacją. Łączy różne perspektywy tej samej chwili w jeden wizualny wątek i otwiera się dopiero, gdy zaakceptują je co najmniej 2 osoby.";
"echo.info.how.title" = "Jak to działa";
"echo.info.how.body" = "Echo wykrywa momenty osób, które obserwują się nawzajem, znajdujących się w tym samym miejscu (w promieniu do 500 m) i czasie (w ciągu 24 godz.). Po aktywowaniu możesz przełączać perspektywy (dolny pasek) oraz momenty (góra/dół).";
"echo.info.privacy.title" = "Prywatność";
"echo.info.privacy.body" = "Echo jest tworzone między osobami, które obserwują się nawzajem, ale zachowuje informację o tym, kto mógł je wtedy zobaczyć. Jeśli później relacja się zmieni, Echo nadal będzie widoczne — zostanie rozmyte tylko wtedy, gdy nie należysz do odbiorców momentu (najlepszych znajomych lub niestandardowej listy). W Echo zobaczysz swoje momenty oraz momenty uczestników, którzy je zaakceptowali.";
"echo.info.status.title" = "Statusy";
"echo.info.status.body" = "Aktywne oznacza, że Echo jest nadal otwarte i inne osoby mogą dołączyć w ciągu 24 godzin. Wygasłe oznacza, że ten czas minął, a Echo zostało zamknięte — nikt więcej nie może dołączyć.";
"echo.info.controls.title" = "Sterowanie";
"echo.info.controls.body" = "Przesuwaj w górę lub w dół, aby zmieniać momenty, użyj dolnego paska, aby przełączać perspektywy, a menu, aby opuścić Echo. Nie możesz opuścić aktywnego Echo — ta opcja odblokuje się po upływie 24 godzin. Po opuszczeniu Echo Twoje momenty zostaną z niego usunięte.";
